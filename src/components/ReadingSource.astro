---
import data from '../data/reading.json';
import CoverCredits from './CoverCredits.astro';
interface Props { showCoverCredits?: boolean; }
const { showCoverCredits = true } = Astro.props;
const source: { source?: string; source_method?: string; profile_url?: string; updated: string } = data;
const storygraph = source.source === 'storygraph';
const profile = source.profile_url && /^https:\/\/app\.thestorygraph\.com\/profile\/[a-z0-9_]{3,30}$/.test(source.profile_url) ? source.profile_url : null;
const imported = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(source.updated));
---
<p class="reading-source">
  {storygraph ? <><span>From a {profile ? <a href={profile}>StoryGraph</a> : 'StoryGraph'} export</span><span aria-hidden="true"> · </span><span>Imported <time datetime={source.updated}>{imported}</time></span></> : <span>Shelf updated <time datetime={source.updated}>{imported}</time></span>}
</p>
{showCoverCredits && <CoverCredits />}
<style>
  .reading-source { font-size: var(--text-label); color: var(--muted); margin: 1rem 0 1.5rem; line-height: 1.7; }
  .reading-source a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: .35rem; margin: -.5rem -.35rem; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .reading-source a:hover { color: var(--on-mark); }
</style>
