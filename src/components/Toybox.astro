---
// The playable notes: one card per toy, cover first. The cover and title open the note; Play opens the toy itself.
interface Toy { title: string; summary: string; href: string; play: string; cover?: string; }
interface Props { toys: Toy[]; }
const { toys } = Astro.props;
const shortTitle = (title: string) => title.split(':')[0];
const tagline = (title: string) => {
  const rest = title.includes(':') ? title.slice(title.indexOf(':') + 1).trim() : '';
  return rest && rest[0].toUpperCase() + rest.slice(1);
};
---
<ul class="toybox">
  {toys.map(toy => <li class="toy">
    <a class="toy-cover" href={toy.href} tabindex="-1" aria-hidden="true">{toy.cover && <img src={toy.cover} alt="" width="1200" height="750" loading="lazy" decoding="async" />}</a>
    <div class="toy-body">
      <h3><a href={toy.href}>{shortTitle(toy.title)}</a></h3>
      {tagline(toy.title) && <p class="toy-tagline">{tagline(toy.title)}</p>}
      <div class="toy-actions"><a class="toy-play" href={toy.play}>Play <span aria-hidden="true">↗</span><span class="toy-sr"> {shortTitle(toy.title)}</span></a><a class="toy-read" href={toy.href}>The note<span class="toy-sr"> on {shortTitle(toy.title)}</span></a></div>
    </div>
  </li>)}
</ul>
<style>
  .toybox { list-style: none; margin: 0 0 4rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .toy { display: flex; flex-direction: column; background: var(--bg); border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .toy-cover { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); }
  .toy-cover:hover { background: var(--surface); }
  .toy-cover img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, filter .5s ease; filter: saturate(.85) brightness(.9); }
  .toy:hover .toy-cover img, .toy:focus-within .toy-cover img { transform: scale(1.035); filter: none; }
  .toy-body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem 1.25rem 1rem; }
  h3 { font-size: var(--text-title); font-weight: 450; line-height: 1.2; letter-spacing: -.02em; margin: 0; }
  h3 a { text-decoration: none; color: var(--ink); }
  h3 a:hover { background: transparent; color: var(--accent); }
  .toy-tagline { color: var(--muted); font-size: var(--text-label); line-height: 1.5; margin: .4rem 0 1rem; }
  .toy-actions { margin-top: auto; display: flex; gap: 1.25rem; align-items: center; font-size: var(--text-label); }
  .toy-actions a { min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; text-decoration: none; }
  .toy-play { color: var(--accent); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .toy-play:hover { background: transparent; color: var(--ink); }
  .toy-read { color: var(--muted); }
  .toy-read:hover { background: transparent; color: var(--accent); }
  .toy-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .toy-cover img { transition: none; } }
</style>
