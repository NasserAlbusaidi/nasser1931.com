---
import data from '../data/training.json';

const formatDistance = (km) => (km == null ? null : `${km.toFixed(1)}km`);

const formatDuration = (min) => {
	if (min == null) return null;
	if (min < 60) return `${min}min`;
	const h = Math.floor(min / 60);
	const m = min % 60;
	return m === 0 ? `${h}h` : `${h}h${m}m`;
};

const formatRelative = (iso) => {
	if (!iso) return null;
	const then = new Date(iso).getTime();
	const now = Date.now();
	const diffMin = Math.max(0, Math.round((now - then) / 60000));
	if (diffMin < 60) return `${diffMin}m ago`;
	const diffH = Math.round(diffMin / 60);
	if (diffH < 48) return `${diffH}h ago`;
	const diffD = Math.round(diffH / 24);
	return `${diffD}d ago`;
};

const recent = (data.recent ?? []).slice(0, 3);
const updatedRel = formatRelative(data.updated);
const form = data.form ?? 'neutral';
const formTsb = data.form_tsb;
const tsbDisplay = formTsb == null ? '—' : (formTsb > 0 ? `+${Math.round(formTsb)}` : Math.round(formTsb).toString());
const weeklyHours = data.weekly_hours ?? 0;
const weeklyTss = data.weekly_tss ?? 0;
---

<div class="pulse">
	<div class="pulse-header">
		<span class="eyebrow">Training pulse</span>
		{updatedRel && (
			<span class="pulse-updated-line">
				updated <span class="mono" data-iso={data.updated}>{updatedRel}</span>
			</span>
		)}
	</div>

	<div class="pulse-stats">
		<div class="pulse-stat">
			<div class="num">
				{Number.isInteger(weeklyHours) ? weeklyHours : weeklyHours.toFixed(1)}<span class="unit">h</span>
			</div>
			<div class="sub">this week</div>
		</div>
		<div class="pulse-stat">
			<div class="num">{weeklyTss}</div>
			<div class="sub">TSS</div>
		</div>
		<div class="pulse-stat">
			<div class="num">{tsbDisplay}</div>
			<div class="sub">form (TSB)</div>
		</div>
	</div>

	<div class="form-line">
		<span class="lbl">form</span>
		<span class={`form-tag form-${form}`}>{form}</span>
		{recent.length > 0 && (
			<>
				<span class="bullet">·</span>
				<span class="lbl">{recent.length} recent sessions</span>
			</>
		)}
	</div>

	{recent.length > 0 && (
		<ul class="pulse-list">
			{recent.map((r) => (
				<li>
					<time class="mono" datetime={r.date}>{r.date.slice(5).replace('-', ' / ')}</time>
					<span class="pulse-name">
						{r.name}
						{r.distance_km != null && (
							<>
								<span class="bullet">·</span>
								<span class="mono">{formatDistance(r.distance_km)}</span>
							</>
						)}
						{r.duration_min != null && (
							<>
								<span class="bullet">·</span>
								<span class="mono">{formatDuration(r.duration_min)}</span>
							</>
						)}
					</span>
				</li>
			))}
		</ul>
	)}
</div>

<script is:inline>
	(function () {
		const fmt = (iso) => {
			const then = new Date(iso).getTime();
			if (Number.isNaN(then)) return null;
			const diffMin = Math.max(0, Math.round((Date.now() - then) / 60000));
			if (diffMin < 60) return diffMin + 'm ago';
			const diffH = Math.round(diffMin / 60);
			if (diffH < 48) return diffH + 'h ago';
			return Math.round(diffH / 24) + 'd ago';
		};
		document.querySelectorAll('.pulse [data-iso]').forEach((el) => {
			const out = fmt(el.dataset.iso);
			if (out) el.textContent = out;
		});
	})();
</script>

<style>
	.pulse {
		background: var(--surface);
		border: 1px solid var(--rule);
		padding: 1rem 1.125rem 1.125rem;
		font-family: var(--font-mono);
	}

	.pulse-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		padding-bottom: 0.625rem;
		border-bottom: 1px solid var(--rule);
		margin-bottom: 0.875rem;
	}

	.pulse-header .eyebrow {
		color: var(--ink);
		font-weight: 600;
	}

	.pulse-updated-line {
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
	}

	.pulse-updated-line .mono {
		color: var(--ink);
	}

	.pulse-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.875rem;
		margin-bottom: 0.875rem;
	}

	.pulse-stat .num {
		font-family: var(--font-display);
		font-weight: 900;
		font-variation-settings: "opsz" 9, "SOFT" 0, "WONK" 0;
		font-size: 28px;
		line-height: 1;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.pulse-stat .num .unit {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 14px;
		color: var(--muted);
		margin-left: 2px;
	}

	.pulse-stat .sub {
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--muted);
		margin-top: 0.4rem;
	}

	.form-line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		align-items: baseline;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted);
		padding: 0.5rem 0;
		border-top: 1px dotted var(--rule);
	}

	.form-line .lbl {
		color: var(--muted);
	}

	.form-line .bullet {
		color: var(--rule);
	}

	.form-tag {
		font-weight: 600;
		font-size: 10px;
		letter-spacing: 0.18em;
		padding: 1px 5px;
		border-radius: var(--radius-sm);
	}

	.form-tag.form-fresh {
		color: var(--accent);
		background: var(--accent-soft);
	}

	.form-tag.form-neutral {
		color: var(--ink);
		background: transparent;
		border: 1px solid var(--rule);
		padding: 0 4px;
	}

	.form-tag.form-fatigued {
		color: var(--warning);
		background: color-mix(in oklab, var(--warning) 14%, transparent);
	}

	.pulse-list {
		list-style: none;
		padding: 0;
		margin: 0.625rem 0 0;
		border-top: 1px dotted var(--rule);
	}

	.pulse-list li {
		display: grid;
		grid-template-columns: 4em 1fr;
		gap: 0.75rem;
		align-items: baseline;
		padding: 0.5rem 0;
		border-bottom: 1px dotted var(--rule);
		font-size: 11px;
		color: var(--ink);
	}

	.pulse-list li:last-child {
		border-bottom: 0;
	}

	.pulse-list time {
		font-family: var(--font-mono);
		font-feature-settings: "tnum" 1;
		font-size: 11px;
		letter-spacing: 0.04em;
		color: var(--muted);
		text-transform: uppercase;
	}

	.pulse-name {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4em;
	}

	.pulse-name .bullet {
		color: var(--rule);
	}

	.pulse-name .mono {
		font-family: var(--font-mono);
		font-feature-settings: "tnum" 1;
		font-size: 11px;
		color: var(--muted);
	}
</style>
