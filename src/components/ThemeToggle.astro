---
// Light <-> dark toggle. Boot script in BaseHead applies html.dark before
// paint to avoid FOUC. Persists to localStorage key "np-theme".
---

<button
	type="button"
	id="theme-toggle"
	aria-label="Toggle color theme"
	title="Toggle theme"
>
	<span class="toggle-word toggle-dark">dark</span>
	<span class="toggle-word toggle-light">light</span>
</button>

<style>
	#theme-toggle {
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		background: transparent;
		border: 0;
		padding: 1px 4px;
		color: var(--muted);
		cursor: pointer;
		transition: color 70ms ease-out, background-color 70ms ease-out;
	}

	#theme-toggle:hover {
		color: var(--on-mark);
		background: var(--mark);
	}

	#theme-toggle:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	/* Show the mode you'd switch to. */
	.toggle-dark { display: inline; }
	.toggle-light { display: none; }
	:global(html.dark) .toggle-dark { display: none; }
	:global(html.dark) .toggle-light { display: inline; }
</style>

<script is:inline>
	(function () {
		var btn = document.getElementById('theme-toggle');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var root = document.documentElement;
			var nowDark = !root.classList.contains('dark');
			root.classList.toggle('dark', nowDark);
			try {
				localStorage.setItem('np-theme', nowDark ? 'dark' : 'light');
			} catch (_) {
				/* no-op */
			}
		});
	})();
</script>
