<button type="button" id="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
  <span class="toggle-dark" aria-hidden="true">Dark</span>
  <span class="toggle-light" aria-hidden="true">Light</span>
</button>
<style>
  #theme-toggle { font: 400 var(--text-label)/1.4 var(--font-ui); background: transparent; color: var(--ink); border: 1px solid var(--rule); border-radius: 2rem; padding: .5rem 1rem; min-height: 44px; min-width: 72px; }
  #theme-toggle:hover { background: var(--mark); }
  .toggle-dark { display: none; }
  .toggle-light { display: inline; }
  :global(html.light) .toggle-dark { display: inline; }
  :global(html.light) .toggle-light { display: none; }
</style>
<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var root = document.documentElement;
    function label() {
      var action = root.classList.contains('light') ? 'Switch to dark theme' : 'Switch to light theme';
      btn.setAttribute('aria-label', action);
      btn.setAttribute('title', action);
    }
    label();
    btn.addEventListener('click', function () {
      var theme = root.classList.contains('light') ? 'dark' : 'light';
      root.classList.toggle('dark', theme === 'dark');
      root.classList.toggle('light', theme === 'light');
      root.style.colorScheme = theme;
      document.querySelector('meta[name="color-scheme"]').setAttribute('content', theme);
      try { localStorage.setItem('np-theme', theme); } catch (_) {}
      label();
    });
  })();
</script>
