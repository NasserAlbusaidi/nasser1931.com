---
// Section heading on the homepage: the section's orrery body, "Body · Section",
// the heading, and a link to the full page.
import PlanetMark from './PlanetMark.astro';

type Props = { body: 'earth' | 'mars' | 'notes' | 'saturn'; label: string; title: string; id: string; href: string; link: string };
const { body, label, title, id, href, link } = Astro.props;
---
<div class="planet-heading">
  <PlanetMark body={body} />
  <div class="planet-heading-text"><p class="eyebrow">{label}</p><h2 id={id}>{title}</h2></div>
  <a class="quiet-link" href={href}>{link} <span aria-hidden="true">→</span></a>
</div>
<style>
  .planet-heading { display: grid; grid-template-columns: 3.75rem minmax(0, 1fr) auto; align-items: center; column-gap: 1rem; padding-bottom: 1.75rem; }
  .planet-heading :global(.planet-mark) { justify-self: center; }
  .planet-heading-text .eyebrow { margin-bottom: .35rem; }
  .planet-heading h2 { font-size: var(--text-heading); font-weight: 350; line-height: 1.1; letter-spacing: -.03em; }
  @media (max-width: 720px) {
    .planet-heading { grid-template-columns: 3rem minmax(0, 1fr); row-gap: .25rem; padding-bottom: 1.25rem; }
    .planet-heading > .quiet-link { grid-column: 2; }
  }
</style>
