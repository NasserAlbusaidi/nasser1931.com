---
// /races build-up: every race oldest first, its bar as long as the distance
// raced and split by leg, with the time since the race before.
import { ladder } from '../lib/race-story';
import type { Race } from '../lib/races';

type Props = { races: Race[] };
const rungs = ladder(Astro.props.races);
const longest = Math.max(...rungs.map(rung => rung.km));
const fmt = (value: string) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const legClass = (leg: string) => `rung-leg-${leg.toLowerCase().replace(/[^a-z0-9]+/g, '')}`;
const km = (value: number) => `${value.toLocaleString('en-GB', { maximumFractionDigits: 1 })} km`;
---
{rungs.length > 1 && <ol class="race-ladder">
  {rungs.map(rung => <li>
    {rung.gap && <p class="rung-gap">{rung.gap}</p>}
    <div class="rung">
      <time datetime={rung.race.date}>{fmt(rung.race.date)}</time>
      <p class="rung-name">{rung.race.name}<span>{rung.race.kind}</span></p>
      <div class="rung-track" role="img" aria-label={`${km(rung.km)}: ${rung.legs.map(leg => `${leg.leg.toLowerCase()} ${km(leg.km)}`).join(', ')}`}>
        <div class="rung-bar" style={`width:${(rung.km / longest * 100).toFixed(2)}%`}>
          {rung.legs.map(leg => <span class:list={['rung-leg', legClass(leg.leg)]} style={`flex-grow:${leg.km}`}></span>)}
        </div>
      </div>
      <p class="rung-km">{km(rung.km)}</p>
    </div>
  </li>)}
</ol>}
<style>
  .race-ladder { list-style: none; margin: 0 0 3.5rem; padding: 0; }
  .rung { display: grid; grid-template-columns: 7.5rem minmax(10rem, 15rem) minmax(0, 1fr) 4.5rem; gap: 1.25rem; align-items: center; padding: .9rem 0; border-top: 1px solid var(--rule); }
  .race-ladder li:first-child .rung { border-top: 0; }
  .rung time, .rung-km, .rung-gap { font: var(--text-label)/1.4 var(--font-mono); color: var(--muted); }
  .rung-name { margin: 0; font-size: var(--text-body); line-height: 1.3; }
  .rung-name span { display: block; font-size: var(--text-label); color: var(--muted); }
  .rung-track { min-width: 0; }
  .rung-bar { display: flex; gap: 2px; height: 10px; min-width: 6px; }
  .rung-leg { flex-basis: 0; min-width: 3px; border-radius: 1px; background: var(--muted); }
  .rung-leg-swim { background: #5B9BD5; }
  .rung-leg-bike { background: var(--accent); }
  .rung-leg-run { background: #7FB77E; }
  .rung-km { margin: 0; text-align: right; color: var(--ink); }
  /* The gap sits between two rungs, under the dates, so the column reads as a time line. */
  .rung-gap { margin: 0; padding: .35rem 0; border-top: 1px dashed var(--rule); }
  .rung-gap + .rung { border-top: 0; }
  @media (max-width: 720px) {
    .rung { grid-template-columns: minmax(0, 1fr) auto; gap: .5rem 1rem; }
    .rung time { grid-column: 1 / -1; }
    .rung-track { grid-column: 1 / -1; grid-row: 3; }
    .rung-name { grid-row: 2; }
    .rung-km { grid-row: 2; }
  }
</style>
