---
const today = new Date();
---

<footer class="site-footer">
	<div class="inner">
		<p class="meta">
			<span class="muted">Muscat, Oman</span>
			<span class="dot">/</span>
			<a href="https://github.com/NasserAlbusaidi">github</a>
			<span class="dot">/</span>
			<a href="mailto:nasserbusaidi@gmail.com">email</a>
			<span class="dot">/</span>
			<a href="/rss.xml">rss</a>
			<span class="dot">/</span>
			<a href="https://github.com/NasserAlbusaidi/nasser1931.com">source</a>
		</p>
		<p class="copy">
			<span class="muted">© {today.getFullYear()} Nasser Al Busaidi.</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--rule);
		padding: 1.5rem 1.5rem 2.5rem;
	}

	.inner {
		max-width: calc(var(--container-wide) - 3rem);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta,
	.copy {
		margin: 0;
		font-family: var(--font-ui);
		font-feature-settings: "tnum" 1;
		font-size: 14px;
		line-height: 1.5;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.muted {
		color: var(--muted);
	}

	.dot {
		color: var(--rule);
		user-select: none;
	}

	.meta a {
		padding-block: .5rem;
		color: var(--muted);
		text-decoration: none;
	}

	.meta a:hover {
		background: var(--mark);
		color: var(--on-mark);
	}
</style>
