---
const today = new Date();
---

<footer class="site-footer">
	<div class="inner">
		<p class="meta">
			<a href="https://github.com/NasserAlbusaidi">github</a>
			<span class="dot">/</span>
			<a href="https://www.linkedin.com/in/nasser-albusaidi-308642113/">linkedin</a>
			<span class="dot">/</span>
			<a href="mailto:nasserbusaidi@gmail.com">email</a>
			<span class="dot">/</span>
			<a href="/rss.xml">rss</a>
			<span class="dot">/</span>
			<a href="https://github.com/NasserAlbusaidi/nasser1931.com">source</a>
		</p>
		<p class="copy">
			<span class="muted">© {today.getFullYear()} Nasser Al Busaidi.</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--rule);
		padding: 1.5rem 0 2.5rem;
	}

	.inner {
		max-width: var(--container-wide);
        padding-inline: var(--gutter);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.meta,
	.copy {
		margin: 0;
		font-family: var(--font-ui);
		font-feature-settings: "tnum" 1;
		font-size: var(--text-label);
		line-height: 1.5;
		display: flex;
		flex-wrap: wrap;
		gap: .75rem;
		align-items: center;
	}

	.muted {
		color: var(--muted);
	}

	.dot {
		color: var(--rule);
		user-select: none;
	}

	.meta a {
		padding: .5rem;
        margin-inline: -.5rem;
        display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px;
		color: var(--muted);
		text-decoration: none;
	}

	.meta a:hover {
		background: var(--mark);
		color: var(--on-mark);
	}
</style>
