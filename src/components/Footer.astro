---
const today = new Date();
---

<footer class="site-footer">
	<div class="inner">
		<p class="meta">
			<span class="muted">Muscat, Oman</span>
			<span class="dot">/</span>
			<a href="https://github.com/NasserAlbusaidi">github</a>
			<span class="dot">/</span>
			<a href="/rss.xml">rss</a>
			<span class="dot">/</span>
			<a href="https://github.com/NasserAlbusaidi/nasser1931.com">source</a>
		</p>
		<p class="copy">
			<span class="muted">© {today.getFullYear()} Nasser Al Busaidi. Built by hand.</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		border-top: 1px solid var(--rule);
		padding: 2rem 1.25rem 4rem;
	}

	.inner {
		max-width: var(--container-wide);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta,
	.copy {
		margin: 0;
		font-family: var(--font-mono);
		font-feature-settings: "tnum" 1;
		font-size: 12px;
		line-height: 1.5;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.muted {
		color: var(--muted);
	}

	.dot {
		color: var(--rule);
		user-select: none;
	}

	.meta a {
		color: var(--muted);
		text-decoration: none;
	}

	.meta a:hover {
		background: var(--mark);
		color: var(--on-mark);
	}
</style>
