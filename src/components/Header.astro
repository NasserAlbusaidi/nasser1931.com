---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	variant?: 'cover' | 'compact';
}

const { variant = 'cover' } = Astro.props;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class:list={['site-header', variant]}>
	<div class="bar">
		<a href="/" class="wordmark" aria-label="Nasser Al Busaidi — home"><span class="brand-star" aria-hidden="true">✦</span>NASSER<span class="brand-number">/ 1931</span></a>
		<nav class="site-nav" aria-label="Sections">
			<HeaderLink href="/builds">Work</HeaderLink>
			<HeaderLink href="/stupidshit">Notes</HeaderLink>
			<HeaderLink href="/field">Life</HeaderLink>
			<HeaderLink href="/reading">Reading</HeaderLink>
		</nav>
		<div class="header-context"><span>Muscat, Earth</span><ThemeToggle /></div>
	</div>
</header>

<style>
	.site-header {
		max-width: var(--container-wide);
		margin: 0 auto;
		padding: 1.25rem 2rem 0;
	}

	.site-header.compact {
		max-width: var(--container-wide);
	}

	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		border-bottom: 1px solid var(--rule);
		padding-bottom: 0.75rem;
	}

	.wordmark {
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: 17px;
		line-height: 1;
		letter-spacing: .12em;
		color: var(--ink);
		text-decoration: none;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}
	.brand-star { color: var(--accent); font-size: 1.5rem; margin-right: .7rem; }
	.brand-number { color: var(--muted); font-family: var(--font-mono); font-weight: 400; font-size: .75rem; letter-spacing: .02em; margin-left: .7rem; }

	.wordmark:hover {
		background: transparent;
		color: var(--accent);
	}

	.site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem .6rem;
		font-family: var(--font-ui);
		font-size: 14px;
		font-weight: 500;
	}

	.site-nav :global(a) {
		color: var(--muted);
		text-decoration: none;
		padding: .65rem .75rem;
		border-radius: 0;
		min-height: 44px;
		transition: color 70ms ease-out, background-color 70ms ease-out;
	}

	.site-nav :global(a:hover) {
		color: var(--on-mark);
		background: var(--mark);
		text-decoration: none;
	}

	.site-nav :global(a.active) {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 6px;
	}
	.header-context { display: flex; align-items: center; gap: 1rem; font-family: var(--font-mono); font-size: .75rem; color: var(--muted); }
	@media (max-width: 900px) { .header-context > span { display: none; } }

	@media (max-width: 720px) {
		.site-header { padding: .8rem 1.25rem 0; }
		.bar {
			flex-wrap: wrap;
			gap: .25rem 1rem;
		}
		.site-nav { order: 3; font-size: 14px; gap: 0 .2rem; width: 100%; justify-content: space-between; }
		.site-nav :global(a) { padding: .65rem .35rem; }
	}
</style>
