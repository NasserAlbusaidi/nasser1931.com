---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	variant?: 'cover' | 'compact';
}

const { variant = 'cover' } = Astro.props;
---

<header class:list={['site-header', variant]}>
	<div class="bar">
		<a href="/" class="wordmark" aria-label="nasser1931.com — home">nasser1931</a>
		<nav class="site-nav" aria-label="Sections">
			<HeaderLink href="/paper">paper</HeaderLink>
			<HeaderLink href="/field">field</HeaderLink>
			<HeaderLink href="/stupidshit">stupidshit</HeaderLink>
			<HeaderLink href="/reading">reading</HeaderLink>
			<HeaderLink href="/coach">coach</HeaderLink>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.site-header {
		max-width: var(--container-wide);
		margin: 0 auto;
		padding: 1.25rem 1.5rem 0;
	}

	.site-header.compact {
		max-width: var(--container-prose);
	}

	.bar {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1.5rem;
		border-bottom: 3px solid var(--ink);
		padding-bottom: 0.75rem;
	}

	.wordmark {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 28px;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
		flex-shrink: 0;
	}

	.wordmark:hover {
		background: var(--mark);
		color: var(--on-mark);
	}

	.site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.site-nav :global(a) {
		color: var(--muted);
		text-decoration: none;
		padding: 1px 4px;
		transition: color 70ms ease-out, background-color 70ms ease-out;
	}

	.site-nav :global(a:hover) {
		color: var(--on-mark);
		background: var(--mark);
		text-decoration: none;
	}

	.site-nav :global(a.active) {
		color: var(--on-mark);
		background: var(--mark);
	}

	@media (max-width: 720px) {
		.site-header { padding: 1rem 1rem 0; }
		.bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
		.site-nav { font-size: 14px; gap: 0.25rem 0.75rem; }
	}
</style>
