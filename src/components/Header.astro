---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<nav>
		<a href="/" class="brand" aria-label="nasser1931.com — home">
			<span class="brand-text">nasser1931<span class="brand-dot">.</span>com</span>
		</a>
		<div class="links">
			<HeaderLink href="/paper">paper</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<HeaderLink href="/field">field</HeaderLink>
			<HeaderLink href="/stupidshit">stupidshit</HeaderLink>
			<HeaderLink href="/reading">reading</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(140%) blur(8px);
		-webkit-backdrop-filter: saturate(140%) blur(8px);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		border-bottom: 1px solid var(--rule);
	}

	nav {
		max-width: var(--container-wide);
		margin: 0 auto;
		padding: 0.85rem 1.25rem;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 17px;
		font-variation-settings: "opsz" 36;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
		transition: color 100ms ease-out;
	}

	.brand:hover {
		color: var(--ink);
	}

	.brand-text {
		display: inline-block;
	}

	.brand-dot {
		color: var(--accent);
	}

	.links {
		display: flex;
		gap: 0.25rem;
		flex: 1;
		flex-wrap: wrap;
	}

	.links :global(a) {
		font-family: var(--font-ui);
		font-size: 14px;
		font-weight: 400;
		color: var(--muted);
		text-decoration: none;
		padding: 0.35rem 0.55rem;
		border-radius: var(--radius-md);
		transition: color 100ms ease-out, background-color 100ms ease-out;
	}

	.links :global(a:hover) {
		color: var(--ink);
		background: var(--surface);
	}

	.links :global(a.active) {
		color: var(--ink);
		font-weight: 500;
	}

	.links :global(a.active::before) {
		content: "";
		display: inline-block;
		width: 4px;
		height: 4px;
		border-radius: var(--radius-full);
		background: var(--accent);
		margin-right: 0.4em;
		vertical-align: 2px;
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			column-gap: 0.5rem;
			row-gap: 0.4rem;
			padding: 0.65rem 1rem;
		}
		.brand {
			font-size: 16px;
		}
		.links {
			order: 3;
			flex: 0 0 100%;
			flex-wrap: nowrap;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			margin: 0 -1rem;
			padding: 0 1rem;
		}
		.links::-webkit-scrollbar {
			display: none;
		}
		.links :global(a) {
			flex: 0 0 auto;
			white-space: nowrap;
			padding: 0.3rem 0.5rem;
			font-size: 13px;
		}
	}
</style>
