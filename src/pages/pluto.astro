---
// The hidden room. No nav link, no sitemap entry, no index: you get here by one of the ways in (src/lib/pluto.mjs).
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { WAYS } from '../lib/pluto.mjs';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Pluto — Nasser Al Busaidi" description="You found the ninth body." image={null} noindex /></head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="pluto">
      <section class="pluto-space" aria-labelledby="pluto-title">
        <div class="pluto-inner">
          <div class="pluto-copy">
            <p class="eyebrow">The ninth body</p>
            <h1 id="pluto-title">You found Pluto<span>.</span></h1>
            <p class="pluto-lead">It was demoted to a dwarf planet in 2006, so it doesn't get a section on the map. It gets this room instead.</p>
            <p class="pluto-via" data-pluto-via>You came in by the address bar.</p>
          </div>
          <figure class="pluto-figure" aria-hidden="true">
            <svg class="pluto-globe" viewBox="0 0 400 400">
              <defs>
                <radialGradient id="pluto-base" cx="62%" cy="34%" r="75%">
                  <stop offset="0" stop-color="#e2c8a8" /><stop offset=".55" stop-color="#b48c68" /><stop offset="1" stop-color="#6e4c35" />
                </radialGradient>
                <radialGradient id="pluto-night" cx="70%" cy="28%" r="88%">
                  <stop offset=".45" stop-color="#04060b" stop-opacity="0" /><stop offset=".78" stop-color="#04060b" stop-opacity=".55" /><stop offset="1" stop-color="#04060b" stop-opacity=".92" />
                </radialGradient>
                <filter id="pluto-soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4" /></filter>
                <filter id="pluto-blur-wide" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation="22" /></filter>
                <filter id="pluto-haze" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6" /></filter>
                <!-- Ragged, organic edges for the terrain, then a soft blur so it reads as seen from far off. -->
                <filter id="pluto-terrain" x="-20%" y="-30%" width="140%" height="160%">
                  <feTurbulence type="fractalNoise" baseFrequency=".035" numOctaves="3" seed="7" />
                  <feDisplacementMap in="SourceGraphic" scale="22" xChannelSelector="R" yChannelSelector="G" />
                  <feGaussianBlur stdDeviation="3" />
                </filter>
                <!-- The heart is drawn scaled up, so it gets a gentler version or it stops reading as a heart. -->
                <filter id="pluto-heart" x="-20%" y="-20%" width="140%" height="140%">
                  <feTurbulence type="fractalNoise" baseFrequency=".08" numOctaves="2" seed="4" />
                  <feDisplacementMap in="SourceGraphic" scale="5" xChannelSelector="R" yChannelSelector="G" />
                  <feGaussianBlur stdDeviation="1.6" />
                </filter>
                <filter id="pluto-grain" x="0" y="0" width="100%" height="100%">
                  <feTurbulence type="fractalNoise" baseFrequency=".022" numOctaves="4" seed="3" />
                  <feColorMatrix type="saturate" values="0" />
                </filter>
                <clipPath id="pluto-clip"><circle cx="200" cy="200" r="180" /></clipPath>
              </defs>
              <circle cx="200" cy="200" r="184" fill="none" stroke="#8fb4e6" stroke-width="6" opacity=".35" filter="url(#pluto-haze)" />
              <g clip-path="url(#pluto-clip)">
                <circle cx="200" cy="200" r="180" fill="url(#pluto-base)" />
                <rect x="20" y="20" width="360" height="360" filter="url(#pluto-grain)" opacity=".22" style="mix-blend-mode: multiply" />
                <!-- The greyer north pole (Lowell Regio). -->
                <ellipse cx="205" cy="22" rx="190" ry="70" fill="#8d7867" opacity=".28" filter="url(#pluto-blur-wide)" />
                <!-- The dark reddish band along the equator: Cthulhu Macula west of the heart, smaller patches east of it. -->
                <g filter="url(#pluto-terrain)">
                  <path d="M14 236 C52 214 92 220 128 234 C152 244 172 254 190 270 C176 287 148 295 118 296 C80 299 44 292 16 282 Z" fill="#4a2719" opacity=".9" />
                  <ellipse cx="288" cy="278" rx="36" ry="12" fill="#56301f" opacity=".7" />
                  <ellipse cx="340" cy="270" rx="28" ry="10" fill="#56301f" opacity=".6" />
                  <ellipse cx="381" cy="258" rx="20" ry="9" fill="#56301f" opacity=".5" />
                </g>
                <!-- The heart (Tombaugh Regio); its western lobe, Sputnik Planitia, is the brighter one. -->
                <g transform="translate(166 116) rotate(-14) scale(1.75)">
                  <path d="M50 30 C50 18 34 8 22 18 C10 30 22 48 50 70 C70 52 84 36 76 22 C68 10 52 16 50 30 Z" fill="#efe2d0" opacity=".85" filter="url(#pluto-heart)" />
                  <ellipse cx="34" cy="36" rx="13" ry="20" transform="rotate(-18 34 36)" fill="#fbf6ee" opacity=".75" filter="url(#pluto-soft)" />
                </g>
                <circle cx="200" cy="200" r="180" fill="url(#pluto-night)" />
              </g>
            </svg>
            <span class="pluto-charon"></span>
            <span class="pluto-sun"><i></i>The Sun, from here</span>
          </figure>
        </div>
      </section>

      <div class="pluto-rest">
        <section class="pluto-ways" aria-labelledby="ways-title">
          <div class="pluto-ways-head">
            <h2 id="ways-title" class="eyebrow">Ways in</h2>
            <p data-pluto-count>There are {WAYS.length} ways in.</p>
          </div>
          <ul>
            {WAYS.map(way => <li data-pluto-way-row={way.id} data-label={way.label}><span class="pluto-mark" aria-hidden="true"></span><span class="pluto-way-text">{way.hint}</span><span class="pluto-state">Not yet</span></li>)}
          </ul>
        </section>

        <section class="pluto-notes" aria-labelledby="notes-title">
          <h2 id="notes-title" class="eyebrow">Out here</h2>
          <p>Sunlight takes about five hours to reach Pluto; from its surface the Sun is just the brightest star in the sky.</p>
          <p>The orrery on the homepage has a body for every section. This room isn't a section, so nothing points at it. You only get here on purpose, or by accident.</p>
          <div class="pluto-actions">
            <a class="pluto-button primary" href="https://ig.me/m/nasserdinosaur_" rel="noopener">Tell me you got in <span aria-hidden="true">↗</span></a>
            <a class="pluto-button" href="/"><span aria-hidden="true">←</span> Back to the inner system</a>
          </div>
        </section>
      </div>
    </main>
    <Footer />
    <script>
      import { WAYS, foundWays, isWay } from '../lib/pluto.mjs';
      import { VIA_KEY } from '../scripts/pluto/warp';

      const FOUND_KEY = 'np-pluto-found';
      const read = (store: () => Storage, key: string) => { try { return store().getItem(key); } catch (_) { return null; } };

      let via = read(() => sessionStorage, VIA_KEY);
      try { sessionStorage.removeItem(VIA_KEY); } catch (_) { /* nothing stored */ }
      if (!isWay(via)) via = null;
      let stored: unknown = [];
      try { stored = JSON.parse(read(() => localStorage, FOUND_KEY) ?? '[]'); } catch (_) { /* start fresh */ }
      const found = foundWays(stored, via);
      try { localStorage.setItem(FOUND_KEY, JSON.stringify(found)); } catch (_) { /* not remembered next time */ }

      const used = WAYS.find((way) => way.id === via);
      if (used) document.querySelector('[data-pluto-via]')!.textContent = `You came in by ${used.via}.`;
      for (const id of found) {
        const row = document.querySelector<HTMLElement>(`[data-pluto-way-row="${id}"]`);
        if (!row) continue;
        row.classList.add('is-found', ...(id === via ? ['is-new'] : []));
        row.querySelector('.pluto-way-text')!.textContent = row.dataset.label!;
        row.querySelector('.pluto-state')!.textContent = id === via ? 'Just now' : 'Found';
      }
      const left = WAYS.length - found.length;
      document.querySelector('[data-pluto-count]')!.textContent = left === 0
        ? `All ${WAYS.length} found. Nothing left to find. Probably.`
        : `${found.length} of ${WAYS.length} found.`;
    </script>
  </body>
</html>
<style>
  /* The room is space, so it keeps the dark palette in the light theme, like the hero and the sky closing. */
  .pluto-space { --p-bg: #04060b; --p-ink: #eef2f8; --p-muted: #a6b3c6; --p-accent: #e8bd85;
    position: relative; overflow: hidden; color: var(--p-ink); margin-top: 1.25rem;
    background:
      radial-gradient(1px 1px at 6% 22%, #c9d3e6, transparent), radial-gradient(1px 1px at 18% 78%, #c9d3e6, transparent),
      radial-gradient(1px 1px at 29% 41%, #c9d3e6, transparent), radial-gradient(1.5px 1.5px at 41% 9%, #c9d3e6, transparent),
      radial-gradient(1px 1px at 52% 88%, #c9d3e6, transparent), radial-gradient(1px 1px at 63% 16%, #c9d3e6, transparent),
      radial-gradient(1px 1px at 74% 62%, #c9d3e6, transparent), radial-gradient(1.5px 1.5px at 86% 84%, #c9d3e6, transparent),
      radial-gradient(1px 1px at 93% 33%, #c9d3e6, transparent), radial-gradient(1px 1px at 12% 55%, #c9d3e6, transparent),
      radial-gradient(1px 1px at 37% 66%, #c9d3e6, transparent), radial-gradient(1px 1px at 58% 47%, #c9d3e6, transparent),
      radial-gradient(ellipse 55% 70% at 72% 50%, #0d1522, var(--p-bg) 72%); }
  .pluto-space .eyebrow { color: var(--p-muted); }
  .pluto-inner { max-width: var(--container-wide); margin: 0 auto; padding: 6rem var(--gutter); min-height: min(78svh, 760px);
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 3rem; }
  h1 { color: var(--p-ink); font-size: var(--text-hero); font-weight: 300; line-height: 1; letter-spacing: -.04em; margin: .5rem 0 1.5rem; }
  h1 > span { color: var(--p-accent); }
  .pluto-lead { font-size: var(--text-lead); line-height: 1.6; color: var(--p-ink); max-width: 34ch; margin: 0 0 1.25rem; text-wrap: balance; }
  .pluto-via { font-family: var(--font-mono); font-size: var(--text-label); color: var(--p-accent); margin: 0; }

  .pluto-figure { position: relative; margin: 0; justify-self: center; width: min(100%, 440px); aspect-ratio: 1; }
  .pluto-globe { width: 100%; height: 100%; display: block; }
  .pluto-charon { position: absolute; left: -2%; bottom: 6%; width: 17%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 66% 32%, #c3bfba, #7d7873 55%, #2a2826 90%); box-shadow: inset -6px -4px 12px rgba(4, 6, 11, .7); }
  .pluto-sun { position: absolute; right: -4%; top: -2%; display: flex; align-items: center; gap: .6rem;
    font-family: var(--font-mono); font-size: var(--text-label); color: var(--p-muted); letter-spacing: .04em; }
  .pluto-sun i { width: 5px; height: 5px; border-radius: 50%; background: #fff4e0; box-shadow: 0 0 8px 3px rgba(255, 226, 180, .65); }

  .pluto-rest { max-width: var(--container-wide); margin: 0 auto; padding: 4.5rem var(--gutter) 1rem;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
  .pluto-ways-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: .75rem; }
  .pluto-ways-head h2, .pluto-ways-head p { margin: 0; }
  .pluto-ways-head p { color: var(--muted); font-size: var(--text-label); }
  .pluto-ways ul { list-style: none; margin: 0; padding: 0; }
  .pluto-ways li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    padding: 1rem 0; border-bottom: 1px solid var(--rule); color: var(--muted); font-size: var(--text-body); }
  .pluto-mark { width: 10px; height: 10px; border-radius: 50%; border: 1px solid var(--muted); }
  .pluto-state { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: .04em; }
  .pluto-ways li.is-found { color: var(--ink); }
  .pluto-ways li.is-found .pluto-mark { background: var(--accent); border-color: var(--accent); }
  .pluto-ways li.is-found .pluto-state { color: var(--muted); }
  .pluto-ways li.is-new .pluto-state { color: var(--accent); }

  .pluto-notes h2 { margin: 0 0 1rem; border-bottom: 1px solid var(--rule); padding-bottom: .75rem; }
  .pluto-notes p { color: var(--muted); line-height: 1.7; max-width: 46ch; }
  .pluto-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .pluto-button { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; padding: .65rem 1.1rem;
    border: 1px solid var(--rule); color: var(--ink); text-decoration: none; font-size: var(--text-body); }
  .pluto-button:hover { background: var(--mark); color: var(--on-mark); }
  .pluto-button.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .pluto-button.primary:hover { background: var(--ink); border-color: var(--ink); color: var(--bg); }

  @media (prefers-reduced-motion: no-preference) {
    .pluto-copy { animation: pluto-arrive .9s ease-out both; }
    .pluto-figure { animation: pluto-arrive 1.4s .15s ease-out both; }
    .pluto-ways li.is-new .pluto-mark { animation: pluto-ping 1.6s ease-out 2; }
  }
  @keyframes pluto-arrive { from { opacity: 0; transform: translateY(14px); } }
  @keyframes pluto-ping { 0% { box-shadow: 0 0 0 0 rgba(232, 189, 133, .7); } 100% { box-shadow: 0 0 0 12px rgba(232, 189, 133, 0); } }

  @media (max-width: 900px) {
    .pluto-inner { grid-template-columns: minmax(0, 1fr); padding: 3.5rem var(--gutter) 3rem; min-height: 0; gap: 2.5rem; }
    .pluto-figure { width: min(78%, 360px); }
    .pluto-rest { grid-template-columns: minmax(0, 1fr); gap: 3rem; padding-top: 3rem; }
  }
  @media (max-width: 480px) { .pluto-sun { right: 0; top: -1.5rem; } }
</style>
