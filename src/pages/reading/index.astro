---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import data from '../../data/reading.json';

type Book = {
	title: string;
	author: string | null;
	status: string | null;
	rating: number | null;
	format: string | null;
	genres: string[];
	started: string | null;
	finished: string | null;
};

const currently: Book[] = data.currently_reading ?? [];
const finished: Book[] = data.finished ?? [];
const wantTo: Book[] = data.want_to_read ?? [];
const stats = data.stats ?? { finished_total: 0, finished_this_year: 0 };
const updatedISO: string | null = data.updated ?? null;

const thisYear = new Date().getUTCFullYear();

// Group finished books by year for a denser list.
const finishedByYear = new Map<string, Book[]>();
for (const b of finished) {
	const y = b.finished?.slice(0, 4) ?? 'undated';
	if (!finishedByYear.has(y)) finishedByYear.set(y, []);
	finishedByYear.get(y)!.push(b);
}

const stars = (n: number | null): string => (n == null ? '' : '★'.repeat(n));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Reading — Nasser Al Busaidi" description="Books finished, currently reading, and what's next. Synced from Notion." />
	</head>
	<body>
		<Header />
		<main>
			<header class="toc-header">
				<div>
					<span class="eyebrow eyebrow-accent">Section · the shelves</span>
					<h1>Reading.</h1>
				</div>
				<div class="toc-meta">
					<span class="num">{stats.finished_total}</span> finished
					<span class="bullet">·</span>
					<span class="num">{stats.finished_this_year}</span> in {thisYear}
					{updatedISO && (
						<>
							<span class="bullet">·</span>
							updated <span class="num" data-iso={updatedISO}>recently</span>
						</>
					)}
				</div>
			</header>

			{currently.length > 0 && (
				<section class="shelf">
					<h2 class="shelf-head">Currently</h2>
					<ul class="books">
						{currently.map((b) => (
							<li>
								<span class="book-title-cell">
									<span class="book-title">{b.title}</span>
									{b.author && <span class="author">· {b.author}</span>}
								</span>
								<span class="meta-cell">
									{b.started && <time class="started" datetime={b.started}>started {b.started}</time>}
									{b.format && <span class="format">{b.format}</span>}
								</span>
							</li>
						))}
					</ul>
				</section>
			)}

			{finished.length > 0 && (
				<section class="shelf">
					<h2 class="shelf-head">Finished</h2>
					{[...finishedByYear.entries()].map(([year, books]) => (
						<>
							<h3 class="year-head">{year}</h3>
							<ul class="books">
								{books.map((b) => (
									<li>
										<span class="book-title-cell">
											<span class="book-title">{b.title}</span>
											{b.author && <span class="author">· {b.author}</span>}
										</span>
										<span class="meta-cell">
											{b.rating != null && (
												<span class="rating" aria-label={`${b.rating} of 5 stars`}>{stars(b.rating)}</span>
											)}
											{b.finished && <time class="finished" datetime={b.finished}>{b.finished.slice(5).replace('-', '/')}</time>}
										</span>
									</li>
								))}
							</ul>
						</>
					))}
				</section>
			)}

			{wantTo.length > 0 && (
				<section class="shelf">
					<h2 class="shelf-head">Want to read</h2>
					<ul class="books">
						{wantTo.map((b) => (
							<li>
								<span class="book-title-cell">
									<span class="book-title">{b.title}</span>
									{b.author && <span class="author">· {b.author}</span>}
								</span>
								<span class="meta-cell">
									{b.format && <span class="format">{b.format}</span>}
								</span>
							</li>
						))}
					</ul>
				</section>
			)}

			{currently.length === 0 && finished.length === 0 && wantTo.length === 0 && (
				<p class="empty"><em>The list is being plumbed in from Notion. Books will appear here once the integration is connected.</em></p>
			)}
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const fmt = (iso) => {
					const then = new Date(iso).getTime();
					if (Number.isNaN(then)) return null;
					const diffMin = Math.max(0, Math.round((Date.now() - then) / 60000));
					if (diffMin < 60) return diffMin + 'm ago';
					const diffH = Math.round(diffMin / 60);
					if (diffH < 48) return diffH + 'h ago';
					return Math.round(diffH / 24) + 'd ago';
				};
				document.querySelectorAll('[data-iso]').forEach((el) => {
					const out = fmt(el.dataset.iso);
					if (out) el.textContent = out;
				});
			})();
		</script>

		<style>
			main {
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: 2.5rem 1.5rem 4rem;
			}

			.toc-header {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 2px solid var(--ink);
				margin-bottom: 1.5rem;
			}

			.toc-header h1 {
				font-family: var(--font-display);
				font-weight: 900;
				font-variation-settings: "opsz" 9, "SOFT" 0, "WONK" 0;
				font-size: clamp(40px, 7vw, 88px);
				line-height: 0.9;
				letter-spacing: -0.03em;
				margin: 0.5rem 0 0;
			}

			.eyebrow {
				display: block;
			}

			.toc-meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--muted);
				white-space: nowrap;
				padding-bottom: 0.5rem;
				display: flex;
				gap: 0.4em;
				align-items: baseline;
			}

			.toc-meta .num { color: var(--ink); }
			.toc-meta .bullet { color: var(--rule); }

			.shelf {
				margin: 2.5rem 0 0;
			}

			.shelf-head {
				font-family: var(--font-display);
				font-weight: 800;
				font-variation-settings: "opsz" 14, "SOFT" 0, "WONK" 0;
				font-size: 24px;
				line-height: 1;
				letter-spacing: -0.01em;
				color: var(--ink);
				margin: 0 0 0.875rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.year-head {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 11px;
				font-weight: 500;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.18em;
				margin: 1.75rem 0 0.5rem;
			}

			.books {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.books li {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 1rem;
				padding: 0.625rem 0;
				border-bottom: 1px solid var(--rule);
				align-items: baseline;
			}

			.book-title-cell {
				min-width: 0;
			}

			.book-title {
				font-family: var(--font-prose);
				font-style: italic;
				color: var(--ink);
				font-size: 16px;
			}

			.author {
				color: var(--muted);
				font-family: var(--font-prose);
				font-style: normal;
				font-size: 15px;
			}

			.meta-cell {
				display: flex;
				gap: 0.875rem;
				align-items: baseline;
				flex-shrink: 0;
			}

			.rating {
				font-size: 11px;
				letter-spacing: 0.1em;
				color: var(--accent);
				white-space: nowrap;
			}

			.finished,
			.started {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 11px;
				color: var(--muted);
				letter-spacing: 0.06em;
				white-space: nowrap;
			}

			.format {
				font-family: var(--font-mono);
				font-size: 10px;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.14em;
				white-space: nowrap;
			}

			.empty {
				font-family: var(--font-prose);
				font-style: italic;
				font-size: 17px;
				color: var(--muted);
				margin: 2rem 0;
			}

			@media (max-width: 540px) {
				.toc-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
				.toc-meta { padding-bottom: 0; flex-wrap: wrap; white-space: normal; }
				.books li { grid-template-columns: 1fr; }
				.meta-cell { padding-top: 0.25rem; }
			}
		</style>
	</body>
</html>
