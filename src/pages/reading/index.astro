---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import data from '../../data/reading.json';

type Book = {
	title: string;
	author: string | null;
	status: string | null;
	rating: number | null;
	format: string | null;
	genres: string[];
	started: string | null;
	finished: string | null;
};

const currently: Book[] = data.currently_reading ?? [];
const finished: Book[] = data.finished ?? [];
const wantTo: Book[] = data.want_to_read ?? [];
const stats = data.stats ?? { finished_total: 0, finished_this_year: 0 };
const updatedISO: string | null = data.updated ?? null;

const thisYear = new Date().getUTCFullYear();

// Group finished books by year for a denser list.
const finishedByYear = new Map<string, Book[]>();
for (const b of finished) {
	const y = b.finished?.slice(0, 4) ?? 'undated';
	if (!finishedByYear.has(y)) finishedByYear.set(y, []);
	finishedByYear.get(y)!.push(b);
}

const stars = (n: number | null): string => {
	if (n == null) return '';
	return '⭐'.repeat(n);
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Reading — Nasser Al Busaidi" description="Books finished, currently reading, and what's next. Synced from Notion." />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<p class="eyebrow">reading</p>
				<h1>Books.</h1>
				<p class="lede">
					<em>Finished, in progress, queued. Synced live from a Notion list.</em>
				</p>
				<p class="stats">
					<span class="num">{stats.finished_total}</span>
					<span class="lbl">books finished</span>
					<span class="dot">·</span>
					<span class="num">{stats.finished_this_year}</span>
					<span class="lbl">in {thisYear}</span>
					{updatedISO && (
						<>
							<span class="dot">·</span>
							<span class="lbl">updated <span data-iso={updatedISO}>recently</span></span>
						</>
					)}
				</p>
			</header>

			{currently.length > 0 && (
				<section class="shelf">
					<h2 class="section-head">currently reading</h2>
					<ul class="books">
						{currently.map((b) => (
							<li>
								<span class="title">{b.title}</span>
								{b.author && <span class="author">{b.author}</span>}
								{b.format && <span class="format">{b.format}</span>}
								{b.started && <time class="started" datetime={b.started}>started {b.started}</time>}
							</li>
						))}
					</ul>
				</section>
			)}

			{finished.length > 0 && (
				<section class="shelf">
					<h2 class="section-head">finished</h2>
					{[...finishedByYear.entries()].map(([year, books]) => (
						<>
							<h3 class="year-head">{year}</h3>
							<ul class="books">
								{books.map((b) => (
									<li>
										{b.finished && <time datetime={b.finished}>{b.finished}</time>}
										<span class="title">{b.title}</span>
										{b.author && <span class="author">{b.author}</span>}
										{b.rating != null && <span class="rating" aria-label={`${b.rating} of 5 stars`}>{stars(b.rating)}</span>}
										{b.format && <span class="format">{b.format}</span>}
									</li>
								))}
							</ul>
						</>
					))}
				</section>
			)}

			{wantTo.length > 0 && (
				<section class="shelf">
					<h2 class="section-head">want to read</h2>
					<ul class="books">
						{wantTo.map((b) => (
							<li>
								<span class="title">{b.title}</span>
								{b.author && <span class="author">{b.author}</span>}
								{b.format && <span class="format">{b.format}</span>}
							</li>
						))}
					</ul>
				</section>
			)}

			{currently.length === 0 && finished.length === 0 && wantTo.length === 0 && (
				<section class="shelf">
					<p class="empty">
						<em>The list is being plumbed in from Notion. Books will appear here once the integration is connected.</em>
					</p>
				</section>
			)}
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const fmt = (iso) => {
					const then = new Date(iso).getTime();
					if (Number.isNaN(then)) return null;
					const diffMin = Math.max(0, Math.round((Date.now() - then) / 60000));
					if (diffMin < 60) return diffMin + 'm ago';
					const diffH = Math.round(diffMin / 60);
					if (diffH < 48) return diffH + 'h ago';
					return Math.round(diffH / 24) + 'd ago';
				};
				document.querySelectorAll('[data-iso]').forEach((el) => {
					const out = fmt(el.dataset.iso);
					if (out) el.textContent = out;
				});
			})();
		</script>

		<style>
			main {
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: 4rem 1.25rem 2rem;
			}

			.page-head {
				margin: 0 0 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.eyebrow {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--accent);
				margin: 0 0 1rem;
			}

			h1 {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 44px;
				line-height: 1.05;
				letter-spacing: -0.02em;
				font-variation-settings: "opsz" 96;
				margin: 0 0 0.75rem;
			}

			.lede {
				font-family: var(--font-body);
				font-size: 17px;
				line-height: 1.55;
				color: var(--muted);
				margin: 0 0 1.25rem;
			}

			.stats {
				margin: 0;
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				line-height: 1.5;
				color: var(--muted);
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				align-items: baseline;
			}

			.stats .num {
				color: var(--ink);
			}

			.stats .dot {
				color: var(--rule);
			}

			.shelf {
				margin: 2.5rem 0 0;
			}

			.section-head {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--muted);
				margin: 0 0 0.75rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.year-head {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 13px;
				font-weight: 500;
				color: var(--muted);
				margin: 1.75rem 0 0.5rem;
			}

			.books {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.books li {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.6em;
				padding: 0.55em 0;
				border-bottom: 1px solid var(--rule);
				font-size: 15px;
			}

			.books li time,
			.books li .started {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 13px;
				color: var(--muted);
				flex-shrink: 0;
				min-width: 5.5em;
			}

			.books li .title {
				color: var(--ink);
				font-family: var(--font-body);
			}

			.books li .author {
				color: var(--muted);
				font-family: var(--font-body);
				font-style: italic;
			}

			.books li .author::before {
				content: '/ ';
				margin-right: 0.1em;
				color: var(--rule);
				font-style: normal;
			}

			.books li .rating {
				font-size: 11px;
				letter-spacing: 0.05em;
				flex-shrink: 0;
			}

			.books li .format {
				font-family: var(--font-mono);
				font-size: 11px;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				flex-shrink: 0;
			}

			.empty {
				font-family: var(--font-body);
				font-size: 15px;
				color: var(--muted);
				margin: 1.5rem 0 0;
			}
		</style>
	</body>
</html>
