---
import { getCollection } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import { captureLine } from '../../lib/sky.mjs';
import '../../styles/sky.css';

const photos = (await getCollection('sky')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = photos[0];
const ogImage = latest ? await getImage({ src: latest.data.photo, width: 1200, format: 'jpg', quality: 85 }) : undefined;
const day = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
const description = 'Night-sky photos from dark places. Capture details come from the camera files.';
// Vite hashes each timelapse into /_astro/, so it can be cached as immutable.
const videos = import.meta.glob<string>('/src/content/sky/*/timelapse.mp4', { query: '?url', import: 'default', eager: true });
const timelapses = new Map(await Promise.all(photos.filter(({ data }) => data.timelapse).map(async ({ id, data }) => {
  const src = videos[`/src/content/sky/${id}/timelapse.mp4`];
  if (!src) throw new Error(`sky entry ${id} declares a timelapse but has no timelapse.mp4`);
  // The poster is one URL for every screen and loads with the page, so it stays
  // small enough not to hold back the photo above it on a phone.
  const poster = await getImage({ src: data.timelapse!.poster, width: 1280, format: 'webp', quality: 75 });
  return [id, { src, poster: poster.src, frames: data.timelapse!.frames }] as const;
})));
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Sky — Nasser Al Busaidi" description={description} image={ogImage ? { src: ogImage.src } : undefined} /></head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="interior">
      <PageIntro title="Sky" eyebrow="After dark" description={description} meta={`${photos.length} ${photos.length === 1 ? 'photo' : 'photos'}`} />
      {photos.length ? <section aria-label="Photos" class="sky-list">
        {photos.map(({ id, data }, index) => <article id={id} class="sky-entry" aria-labelledby={`${id}-title`}>
          <figure class="sky-photo">
            <Picture src={data.photo} alt={data.alt} formats={['webp']} fallbackFormat="webp" widths={[800, 1200, 1600, 2400, 3000]} sizes="(max-width: 1424px) calc(100vw - 4rem), 1360px" quality={85} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
          </figure>
          <div class="sky-entry-copy">
            <div><p class="eyebrow"><time datetime={data.date.toISOString().slice(0, 10)}>{day(data.date)}</time></p><h2 id={`${id}-title`}>{data.title}</h2></div>
            <dl class="sky-facts">
              <div><dt>Location</dt><dd>{data.location}</dd></div>
              {data.camera && <div><dt>Camera</dt><dd>{data.camera}</dd></div>}
              {data.lens && <div><dt>Lens</dt><dd>{data.lens}</dd></div>}
              {captureLine(data) && <div><dt>Capture</dt><dd class="mono">{captureLine(data)}</dd></div>}
            </dl>
          </div>
          {timelapses.has(id) && <figure class="sky-timelapse">
            <video src={timelapses.get(id)!.src} poster={timelapses.get(id)!.poster} width="1920" height="1280" controls loop playsinline preload="none" aria-label={`${data.title}, timelapse`}></video>
            <figcaption class="mono">Timelapse · {timelapses.get(id)!.frames} frames</figcaption>
          </figure>}
        </article>)}
      </section> : <p class="interior-empty">No photos here yet. The next clear night will fix that.</p>}
      <p class="sky-note">Exposure values describe a single frame. Stacked images combine many frames of the same sky.</p>
    </main>
    <Footer />
  </body>
</html>
