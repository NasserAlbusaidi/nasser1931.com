---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="404 — Nasser Al Busaidi" description="This page could not be found." /></head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="lost-page">
      <p class="lost-code" aria-hidden="true">404</p>
      <div><p class="lost-label">Outside the known orbit</p><h1>Lost in space<span>.</span></h1><p class="lost-description">There isn't a page at this address. Let's head back to familiar ground.</p><a class="lost-home" href="/"><span aria-hidden="true">←</span> Back home</a></div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .lost-page { max-width: var(--container-wide); margin: 0 auto; padding: 5rem 2rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); align-items: center; gap: 4rem; }
  .lost-code { color: var(--accent); font-size: var(--text-hero); font-weight: 250; line-height: 1; letter-spacing: -.06em; margin: 0; }
  .lost-label { color: var(--muted); font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: var(--text-display); font-weight: 350; line-height: 1.1; }
  h1 > span { color: var(--accent); }
  .lost-description { color: var(--muted); font-size: var(--text-lead); line-height: 1.7; max-width: 35ch; margin: 1.5rem 0; }
  .lost-home { display: inline-flex; align-items: center; gap: 2rem; text-decoration: none; border-bottom: 1px solid var(--accent); padding-block: .75rem; }
  .lost-home:hover { background: transparent; color: var(--accent); }
  @media (max-width: 720px) { .lost-page { grid-template-columns: minmax(0, 1fr); gap: 2rem; padding: 3rem 1.25rem; } .lost-code { font-size: var(--text-hero); } }
</style>
