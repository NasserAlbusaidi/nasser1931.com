---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import coach from '../data/coach.json';
import bank from '../data/workout-bank.json';
import {
	classifyState,
	getScheduleContext,
	pickWorkoutV1,
	applyV2Overrides,
} from '../scripts/cycling-engine.mjs';

const wellness = coach.wellness ?? {};
const computed = coach.computed ?? {};
const todayISO: string = coach._today ?? new Date().toISOString().slice(0, 10);
const fetchedAt: string | null = coach._fetched_at ?? null;

const today = new Date(todayISO + 'T00:00:00Z');
const longDate = today.toLocaleDateString('en-GB', {
	weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
});

const cls = classifyState(wellness);
const ctx = getScheduleContext(today);
const v1 = pickWorkoutV1(cls.state, ctx, bank);
const pick = applyV2Overrides(v1, computed, bank);

const stateLabel = pick.workoutKey === null
	? (ctx.slot === 'group_ride' ? 'Group ride day' : 'Rest day')
	: pick.workout?.name ?? 'Unknown';

const subtitle = pick.workoutKey === null
	? (ctx.slot === 'group_ride'
		? 'Friday is the group ride — ride what falls. No structured workout to push.'
		: 'No cycling slot scheduled today.')
	: `${pick.workout?.category ?? ''} · key ${pick.workoutKey}`;

const pushCmd = `python3 tools/intervalsicu/pick_workout.py --push --time 05:30`;

const wellnessDateISO: string | null = wellness?.date ?? null;
const wellnessFresh = wellnessDateISO === todayISO;

// 4-day forecast (today + next 3). Today uses real state + v2; future days
// assume AMBER and run v1 only — v2 overrides depend on today's signals.
function dayLabel(d: Date): string {
	return d.toLocaleDateString('en-GB', {
		weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC',
	}).toUpperCase();
}

function buildEntry(offset: number) {
	const date = offset === 0 ? today : new Date(today.getTime() + offset * 86400000);
	const entryCtx = offset === 0 ? ctx : getScheduleContext(date);
	const entryState: string = offset === 0 ? cls.state : 'amber';
	const entryV1 = offset === 0 ? v1 : pickWorkoutV1(entryState, entryCtx, bank);
	const entryPick = offset === 0 ? pick : { ...entryV1, warnings: [] as string[] };

	let slotTag: string;
	if (offset === 0) slotTag = 'today';
	else if (entryCtx.slot === 'group_ride') slotTag = 'group';
	else if (entryCtx.slot) slotTag = entryCtx.slot;
	else slotTag = 'rest';

	let workoutName: string;
	let numerics: string | null = null;
	if (!entryPick.workoutKey) {
		workoutName = entryCtx.slot === 'group_ride' ? 'Group ride day' : 'Rest day';
	} else {
		const wk = entryPick.workout;
		workoutName = wk?.name ?? 'Unknown';
		const dur = wk?.duration_min;
		const tif = wk?.target_if;
		if (dur != null && tif != null) numerics = `${dur}m / ${Number(tif).toFixed(2)}`;
		else if (dur != null) numerics = `${dur}m`;
	}

	return {
		offset,
		dateISO: date.toISOString().slice(0, 10),
		dayLabel: dayLabel(date),
		slotTag,
		workoutName,
		numerics,
		state: entryState,
		pickPayload: {
			workoutKey: entryPick.workoutKey,
			workout: entryPick.workout,
			reasoning: entryPick.reasoning,
			warnings: entryPick.warnings ?? [],
			slot: entryCtx.slot,
			macroWeek: entryCtx.macroWeek,
		},
	};
}

const forecast = [0, 1, 2, 3].map(buildEntry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Coach — Nasser Al Busaidi"
			description="A daily cycling briefing — recovery signals, today's pick, and the reasoning. Driven by intervals.icu."
		/>
	</head>
	<body>
		<Header variant="compact" />
		<main>
			<section class="forecast" aria-label="Four-day forecast">
				<h2 class="forecast-head label">This week</h2>
				<div class="forecast-rows">
					{forecast.map((f) => (
						<button
							type="button"
							class={`forecast-row${f.offset === 0 ? ' active' : ''}`}
							data-idx={f.offset}
							data-date={f.dateISO}
							aria-current={f.offset === 0 ? 'true' : undefined}
						>
							<span class="forecast-when">
								<span class="forecast-day">{f.dayLabel}</span>
								<span class="forecast-dot">/</span>
								<span class="forecast-slot">{f.slotTag}</span>
							</span>
							<span class="forecast-title">{f.workoutName}</span>
							<span class="forecast-num">{f.numerics ?? '—'}</span>
						</button>
					))}
				</div>
				<p class="forecast-footnote">
					Projections assume <span class="flag flag-amber">amber</span> recovery for +1 to +3.
				</p>
			</section>

			<aside class="projection-banner" id="projection-banner" hidden>
				<strong>Projection</strong> ·
				viewing <span class="num" id="proj-date-label">—</span>,
				<span class="num" id="proj-offset-label">+0</span> from today.
				Recovery assumed AMBER; v1 only.
				<button type="button" id="back-to-today">← back to today</button>
			</aside>

			<header class="brief-head">
				<div>
					<span class="label" id="eyebrow-date">Morning briefing · {longDate}</span>
					<h1 id="header-title">{stateLabel}.</h1>
					<p class="subtitle" id="header-subtitle">{subtitle}</p>
				</div>
				<div class="brief-meta">
					<span class={`state-pill state-${cls.state}`} id="state-pill">{cls.state}</span>
					<span class="num" id="meta-week">W{ctx.macroWeek}</span>
					<span class="num" id="meta-slot">{ctx.slot ?? 'rest'}</span>
					{fetchedAt && (
						<span class="updated">updated <span class="num" data-iso={fetchedAt}>recently</span></span>
					)}
				</div>
			</header>

			{!wellnessFresh && wellnessDateISO && (
				<aside class="staleness">
					<strong>Note:</strong> wellness snapshot is from <span class="num">{wellnessDateISO}</span>,
					not today ({todayISO}). intervals.icu's Garmin sync is usually 1–3h behind — refresh later.
				</aside>
			)}

			<section class="block">
				<h2 class="block-head label">Recovery signals</h2>
				<div class="signals">
					{cls.classifications.map((c) => (
						<div class={`signal signal-${c.class}`} data-key={c.key}>
							<div class="signal-label label">{c.label}</div>
							<div class="signal-value">
								{c.value == null
									? <span class="missing">—</span>
									: <>
										<span class="signal-num">{Number.isInteger(c.value) ? c.value : (c.value as number).toFixed(1)}</span>
										<span class="unit">{c.unit}</span>
									</>
								}
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="block">
				<h2 class="block-head label">Computed signals</h2>
				<div class="computed">
					<div class="comp">
						<div class="comp-label label">TSB · form</div>
						<div class="comp-value">
							<span>{computed.tsb ?? '—'}</span>
							{computed.tsb_category && <span class="comp-tag">{computed.tsb_category}</span>}
						</div>
					</div>
					<div class="comp">
						<div class="comp-label label">Ramp rate</div>
						<div class="comp-value">
							<span>{wellness.ramp_rate != null ? Number(wellness.ramp_rate).toFixed(1) : '—'}</span>
							{computed.ramp_rate_category && <span class="comp-tag">{computed.ramp_rate_category}</span>}
						</div>
					</div>
					<div class="comp">
						<div class="comp-label label">Days since hard</div>
						<div class="comp-value">{computed.days_since_hard ?? '—'}</div>
					</div>
					<div class="comp">
						<div class="comp-label label">eFTP 14d</div>
						<div class="comp-value">
							<span>{computed.eftp_14d_ago ?? '—'} → {computed.eftp_current ?? '—'}</span>
							{computed.eftp_trend_status && <span class="comp-tag">{computed.eftp_trend_status}</span>}
						</div>
					</div>
				</div>
			</section>

			<section class="block">
				<h2 class="block-head label">Today's pick</h2>
				<div id="pick-title" class="pick-title">{stateLabel}</div>
				<div id="pick-sub" class="pick-sub">{subtitle}</div>

				<div id="pick-stats" class="pick-stats" style={pick.workoutKey ? '' : 'display:none'}>
					<div>
						<div class="comp-label label">Duration</div>
						<div class="stat-big">
							<span class="stat-num" id="stat-duration">{pick.workout?.duration_min ?? '—'}</span><span class="unit">min</span>
						</div>
					</div>
					<div>
						<div class="comp-label label">Target IF</div>
						<div class="stat-big">
							<span class="stat-num" id="stat-if">{pick.workout?.target_if?.toFixed(2) ?? '—'}</span>
						</div>
					</div>
					<div>
						<div class="comp-label label">Target TSS</div>
						<div class="stat-big">
							<span class="stat-num" id="stat-tss">{pick.workout?.target_tss ?? '—'}</span>
						</div>
					</div>
					<div>
						<div class="comp-label label">Cost</div>
						<div class="stat-big-text" id="stat-cost">{pick.workout?.recovery_cost ?? '—'}</div>
					</div>
				</div>

				<details class="reasoning-details" open>
					<summary>Reasoning</summary>
					<ol id="reasoning-list" class="reasoning">
						{pick.reasoning.map((r) => <li>{r}</li>)}
					</ol>
				</details>

				<div id="warnings" class="warnings" style={(pick.warnings ?? []).length ? '' : 'display:none'}>
					{(pick.warnings ?? []).map((w) => <div class="warning">{w}</div>)}
				</div>

				<pre id="dsl-block" class="dsl" style={pick.workoutKey ? '' : 'display:none'}><code id="dsl-code">{pick.workout?.dsl ?? ''}</code></pre>
			</section>

			<details class="block overrides">
				<summary><span class="block-head label">Override engine inputs</span></summary>
				<div class="control-row">
					<label for="o-state">Force state</label>
					<select id="o-state">
						<option value="">auto ({cls.state})</option>
						<option value="green">GREEN</option>
						<option value="amber">AMBER</option>
						<option value="red">RED</option>
					</select>
				</div>
				<div class="control-row">
					<label for="o-slot">Override slot</label>
					<select id="o-slot">
						<option value="">auto ({ctx.slot ?? 'none'})</option>
						<option value="long">long (Sun)</option>
						<option value="quality">quality (Wed)</option>
						<option value="group_ride">group_ride (Fri)</option>
						<option value="recovery">recovery</option>
					</select>
				</div>
				<div class="control-row">
					<label for="o-week">Override macro week</label>
					<select id="o-week">
						<option value="">auto (W{ctx.macroWeek})</option>
						<option value="1">W1</option>
						<option value="2">W2</option>
						<option value="3">W3</option>
						<option value="4">W4 (eFTP push)</option>
						<option value="5">W5 (recovery)</option>
					</select>
				</div>
				<div class="control-row">
					<label for="o-nov2">Disable v2 overrides</label>
					<input id="o-nov2" type="checkbox" />
				</div>
				<button type="button" id="o-reset" class="btn">Reset</button>
			</details>

			<details class="block push-hint">
				<summary><span class="block-head label">Ship to calendar (manual)</span></summary>
				<p class="hint-prose">
					Push hasn't been wired into the browser yet. Run this from the project root and the
					workout lands on intervals.icu, which Garmin Calendar Sync forwards to the watch.
				</p>
				<div class="copy-row">
					<pre class="cmd"><code id="push-cmd">{pushCmd}</code></pre>
					<button type="button" id="copy-btn" aria-live="polite">Copy</button>
				</div>
			</details>
		</main>
		<Footer />

		<script type="application/json" id="coach-data" set:html={JSON.stringify(coach)}></script>
		<script type="application/json" id="bank-data" set:html={JSON.stringify(bank)}></script>

		<script>
			import {
				classifyState,
				getScheduleContext,
				pickWorkoutV1,
				applyV2Overrides,
			} from '../scripts/cycling-engine.mjs';

			const coach = JSON.parse(document.getElementById('coach-data').textContent);
			const bank  = JSON.parse(document.getElementById('bank-data').textContent);
			const today = new Date(coach._today + 'T00:00:00Z');

			const $ = (id) => document.getElementById(id);
			const oState = $('o-state'), oSlot = $('o-slot'), oWeek = $('o-week'), oNoV2 = $('o-nov2');
			const mainEl = document.querySelector('main');
			const banner = $('projection-banner');
			const forecastRows = Array.from(document.querySelectorAll('.forecast-row'));

			let activeIndex = 0;

			const longDateFmt = (d) => d.toLocaleDateString('en-GB', {
				weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
			});
			const shortDateFmt = (d) => d.toLocaleDateString('en-GB', {
				weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC',
			}).toUpperCase();

			function activeDate() {
				return new Date(today.getTime() + activeIndex * 86400000);
			}

			function recompute() {
				const isToday = activeIndex === 0;
				const date = activeDate();
				const cls = classifyState(coach.wellness ?? {});
				const baselineState = isToday ? cls.state : 'amber';
				const state = oState.value || baselineState;
				const ctx = getScheduleContext(date);
				if (oSlot.value) ctx.slot = oSlot.value;
				if (oWeek.value) ctx.macroWeek = parseInt(oWeek.value, 10);

				const v1 = pickWorkoutV1(state, ctx, bank);
				const skipV2 = oNoV2.checked || !isToday;
				const pick = skipV2
					? { ...v1, warnings: [] }
					: applyV2Overrides(v1, coach.computed ?? {}, bank);

				render(pick, state, ctx, isToday, date);
			}

			function render(pick, state, ctx, isToday, date) {
				const pillEl = $('state-pill');
				pillEl.className = 'state-pill state-' + state;
				pillEl.textContent = isToday ? state : (state + ' · proj');
				$('meta-week').textContent = 'W' + ctx.macroWeek;
				$('meta-slot').textContent = ctx.slot ?? 'rest';

				const eyebrow = $('eyebrow-date');
				const headerTitle = $('header-title');
				const headerLabel = !pick.workoutKey
					? (ctx.slot === 'group_ride' ? 'Group ride day' : 'Rest day')
					: (pick.workout?.name ?? 'Unknown');
				if (eyebrow) {
					eyebrow.textContent = (isToday ? 'Morning briefing · ' : 'Projection · ') + longDateFmt(date);
				}
				if (headerTitle) headerTitle.textContent = headerLabel + '.';

				const title = $('pick-title');
				const sub = $('pick-sub');
				const stats = $('pick-stats');
				const dsl = $('dsl-block');
				const dslCode = $('dsl-code');

				if (!pick.workoutKey) {
					title.textContent = headerLabel;
					sub.textContent = ctx.slot === 'group_ride'
						? 'Friday is the group ride — ride what falls.'
						: 'No cycling slot scheduled.';
					stats.style.display = 'none';
					dsl.style.display = 'none';
				} else {
					const w = pick.workout;
					title.textContent = w.name;
					sub.textContent = `${w.category} · key ${pick.workoutKey}`;
					stats.style.display = '';
					$('stat-duration').textContent = String(w.duration_min ?? '—');
					$('stat-if').textContent = typeof w.target_if === 'number' ? w.target_if.toFixed(2) : '—';
					$('stat-tss').textContent = String(w.target_tss ?? '—');
					$('stat-cost').textContent = w.recovery_cost ?? '—';
					dsl.style.display = '';
					dslCode.textContent = w.dsl ?? '';
				}

				const subtitleEl = $('header-subtitle');
				if (subtitleEl) subtitleEl.textContent = sub.textContent;

				const listEl = $('reasoning-list');
				while (listEl.firstChild) listEl.removeChild(listEl.firstChild);
				for (const r of pick.reasoning) {
					const li = document.createElement('li');
					li.textContent = r;
					listEl.appendChild(li);
				}

				const warns = $('warnings');
				while (warns.firstChild) warns.removeChild(warns.firstChild);
				const warningsArr = pick.warnings ?? [];
				warns.style.display = warningsArr.length ? '' : 'none';
				for (const w of warningsArr) {
					const div = document.createElement('div');
					div.className = 'warning';
					div.textContent = w;
					warns.appendChild(div);
				}

				// Projection chrome — forecast active row, banner, body mode
				forecastRows.forEach((row, i) => {
					const on = i === activeIndex;
					row.classList.toggle('active', on);
					if (on) row.setAttribute('aria-current', 'true');
					else row.removeAttribute('aria-current');
				});
				if (mainEl) mainEl.classList.toggle('projecting', !isToday);
				if (banner) {
					banner.hidden = isToday;
					if (!isToday) {
						$('proj-date-label').textContent = shortDateFmt(date);
						$('proj-offset-label').textContent = '+' + activeIndex + 'd';
					}
				}
			}

			[oState, oSlot, oWeek, oNoV2].forEach((el) => el.addEventListener('input', recompute));
			$('o-reset').addEventListener('click', () => {
				oState.value = '';
				oSlot.value = '';
				oWeek.value = '';
				oNoV2.checked = false;
				recompute();
			});

			forecastRows.forEach((row) => {
				row.addEventListener('click', () => {
					const idx = parseInt(row.dataset.idx ?? '0', 10);
					if (idx === activeIndex) return;
					activeIndex = idx;
					recompute();
				});
			});

			const backBtn = $('back-to-today');
			if (backBtn) {
				backBtn.addEventListener('click', () => {
					if (activeIndex === 0) return;
					activeIndex = 0;
					recompute();
				});
			}

			const copyBtn = $('copy-btn');
			if (copyBtn) {
				copyBtn.addEventListener('click', async () => {
					const cmd = $('push-cmd').textContent;
					try {
						await navigator.clipboard.writeText(cmd);
						copyBtn.textContent = 'copied';
						setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
					} catch {
						copyBtn.textContent = 'copy failed';
					}
				});
			}
		</script>

		<script is:inline>
			(function () {
				const fmt = (iso) => {
					const then = new Date(iso).getTime();
					if (Number.isNaN(then)) return null;
					const diffMin = Math.max(0, Math.round((Date.now() - then) / 60000));
					if (diffMin < 60) return diffMin + 'm ago';
					const diffH = Math.round(diffMin / 60);
					if (diffH < 48) return diffH + 'h ago';
					return Math.round(diffH / 24) + 'd ago';
				};
				document.querySelectorAll('[data-iso]').forEach((el) => {
					const out = fmt(el.dataset.iso);
					if (out) el.textContent = out;
				});
			})();
		</script>

		<style>
			main {
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: 2rem 1.5rem 4rem;
			}

			/* ---- 4-day forecast strip ---- */
			.forecast {
				margin: 0 0 1.75rem;
			}
			.forecast-head {
				color: var(--ink);
				margin: 0;
				padding: 0 0 0.4rem;
				border-bottom: 1px solid var(--ink);
			}
			.forecast-rows {
				display: flex;
				flex-direction: column;
			}
			.forecast-row {
				display: grid;
				grid-template-columns: minmax(150px, auto) 1fr auto;
				gap: 0.875rem;
				align-items: baseline;
				padding: 0.55rem 0.5rem;
				border: 0;
				border-bottom: 1px solid var(--rule);
				background: transparent;
				color: var(--ink);
				text-align: left;
				cursor: pointer;
				font-family: inherit;
				transition: background-color 70ms ease-out, color 70ms ease-out;
			}
			.forecast-row:hover:not(.active) { background: var(--mark); color: var(--on-mark); }
			.forecast-row:hover:not(.active) .forecast-when,
			.forecast-row:hover:not(.active) .forecast-title,
			.forecast-row:hover:not(.active) .forecast-num { color: var(--on-mark); }
			.forecast-row:focus-visible {
				outline: 2px solid var(--ink);
				outline-offset: -2px;
			}
			.forecast-row.active {
				background: var(--ink);
				color: var(--bg);
				cursor: default;
			}
			.forecast-when {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				display: inline-flex;
				gap: 0.4em;
				align-items: baseline;
				white-space: nowrap;
			}
			.forecast-row.active .forecast-when { color: var(--bg); opacity: 0.75; }
			.forecast-row.active .forecast-slot { opacity: 1; font-weight: 600; }
			.forecast-dot { opacity: 0.5; }
			.forecast-title {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 19px;
				line-height: 1.1;
				color: var(--ink);
			}
			.forecast-row.active .forecast-title { color: var(--bg); }
			.forecast-row:not(.active) .forecast-title { color: var(--muted); font-weight: 500; }
			.forecast-row:not(.active):hover .forecast-title { color: var(--on-mark); }
			.forecast-num {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				white-space: nowrap;
			}
			.forecast-row.active .forecast-num { color: var(--bg); }
			.forecast-footnote {
				font-family: var(--font-ui);
				font-size: 13px;
				color: var(--muted);
				margin: 0.75rem 0 0;
				padding-left: 0.5rem;
			}

			/* ---- projection banner (visible when activeIndex > 0) ---- */
			.projection-banner {
				border: 1px solid var(--ink);
				border-left: 4px solid var(--flag-amber);
				padding: 0.6rem 0.875rem;
				margin: 0 0 1.5rem;
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--ink);
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.projection-banner[hidden] { display: none; }
			.projection-banner strong {
				font-family: var(--font-display);
				font-size: 14px;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-weight: 700;
			}
			.projection-banner .num {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
			}
			#back-to-today {
				margin-left: auto;
				font-family: var(--font-display);
				font-size: 13px;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding: 4px 10px;
				background: transparent;
				color: var(--ink);
				border: 1px solid var(--ink);
				cursor: pointer;
			}
			#back-to-today:hover { background: var(--mark); color: var(--on-mark); }

			/* Projection mode mutes today-only sections (signals, computed, push) */
			main.projecting .signals,
			main.projecting .computed {
				opacity: 0.42;
				pointer-events: none;
				transition: opacity 200ms ease-out;
			}
			main.projecting .push-hint { display: none; }

			.brief-head {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 1.5rem;
				align-items: end;
				padding-bottom: 1rem;
				border-bottom: 3px solid var(--ink);
				margin-bottom: 1.75rem;
			}

			.brief-head h1 {
				margin: 0.4rem 0 0;
				font-size: clamp(40px, 7vw, 72px);
				line-height: 0.92;
			}

			.subtitle {
				margin: 0.5rem 0 0;
				font-family: var(--font-ui);
				color: var(--muted);
				font-size: 15px;
			}

			.brief-meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				display: flex;
				gap: 0.75em;
				align-items: baseline;
				flex-wrap: wrap;
				padding-bottom: 0.25rem;
			}
			.brief-meta .num { color: var(--ink); }

			.state-pill {
				font-family: var(--font-display);
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.05em;
				padding: 2px 8px;
				text-transform: uppercase;
				color: #111111;
			}
			.state-pill.state-green { background: var(--flag-green); }
			.state-pill.state-amber { background: var(--flag-amber); }
			.state-pill.state-red   { background: var(--flag-red); }

			.staleness {
				border: 1px solid var(--rule);
				border-left: 4px solid var(--flag-amber);
				padding: 0.75rem 1rem;
				margin: 0 0 1.5rem;
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--muted);
			}
			.staleness strong { color: var(--ink); font-weight: 600; }
			.staleness .num { color: var(--ink); font-family: var(--font-mono); font-size: 0.92em; }

			.block { margin: 2rem 0 0; }

			.block-head {
				color: var(--ink);
				margin: 0 0 0.875rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid var(--ink);
				display: block;
			}

			.signals {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 0.5rem;
			}

			.signal {
				border: 1px solid var(--rule);
				border-top: 3px solid var(--rule);
				padding: 0.5rem 0.625rem;
				background: var(--bg);
			}
			.signal-green { border-top-color: var(--flag-green); }
			.signal-amber { border-top-color: var(--flag-amber); }
			.signal-red   { border-top-color: var(--flag-red); }
			.signal-missing, .signal-neutral { opacity: 0.55; }

			.signal-label {
				font-size: 12px;
				margin-bottom: 0.125rem;
			}
			.signal-value {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 24px;
				line-height: 1;
				color: var(--ink);
			}
			.signal-value .unit {
				font-family: var(--font-mono);
				font-size: 11px;
				margin-left: 0.2em;
				color: var(--muted);
			}
			.signal-value .missing { font-family: var(--font-mono); font-size: 18px; color: var(--muted); }

			.computed {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.5rem;
			}

			.comp {
				border-left: 3px solid var(--rule);
				padding: 0.125rem 0.75rem;
			}

			.comp-label {
				font-size: 12px;
				margin-bottom: 0.2rem;
			}

			.comp-value {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 15px;
				color: var(--ink);
			}

			.comp-tag {
				margin-left: 0.4em;
				font-family: var(--font-display);
				font-size: 12px;
				font-weight: 600;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			.pick-title {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: clamp(28px, 4vw, 40px);
				line-height: 1;
				text-transform: uppercase;
				color: var(--ink);
				margin: 0 0 0.25rem;
			}

			.pick-sub {
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--muted);
				margin-bottom: 1rem;
			}

			.pick-stats {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.75rem;
				margin: 1rem 0;
			}

			.pick-stats .stat-big {
				font-size: clamp(24px, 3vw, 38px);
				color: var(--ink);
			}

			.pick-stats .stat-big .unit {
				font-family: var(--font-mono);
				font-size: 0.4em;
				margin-left: 0.2em;
				color: var(--muted);
				vertical-align: middle;
			}

			.stat-big-text {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 16px;
				color: var(--ink);
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding-top: 0.5rem;
			}

			.reasoning-details { margin: 1rem 0 0; }
			.reasoning-details > summary {
				font-family: var(--font-display);
				font-size: 13px;
				font-weight: 600;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				cursor: pointer;
				padding: 0.25rem 0;
			}
			.reasoning {
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--ink);
				line-height: 1.55;
				margin: 0.5rem 0;
				padding-left: 1.5rem;
			}
			.reasoning li { margin: 0.2rem 0; }

			.warnings { margin: 1rem 0; }
			.warning {
				border: 1px solid var(--rule);
				border-left: 4px solid var(--flag-red);
				padding: 0.6rem 0.875rem;
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--ink);
				margin: 0.5rem 0;
			}

			.dsl {
				margin: 1.25rem 0 0;
				font-size: 13px;
				max-height: 360px;
				overflow-y: auto;
				white-space: pre;
			}
			.dsl code { white-space: pre; }

			.overrides > summary,
			.push-hint > summary {
				cursor: pointer;
				padding: 0.25rem 0;
				list-style: revert;
			}
			.overrides .block-head,
			.push-hint .block-head {
				display: inline-block;
				border: none;
				padding: 0;
				margin: 0;
			}

			.control-row {
				display: grid;
				grid-template-columns: 200px 1fr;
				gap: 0.75rem;
				align-items: center;
				padding: 0.4rem 0;
				font-family: var(--font-mono);
				font-size: 12px;
			}
			.control-row label {
				font-family: var(--font-display);
				font-size: 13px;
				font-weight: 600;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.control-row select {
				font-family: var(--font-mono);
				font-size: 12px;
				padding: 4px 8px;
				background: var(--bg);
				color: var(--ink);
				border: 1px solid var(--rule);
				min-width: 180px;
			}
			.control-row input[type="checkbox"] {
				justify-self: start;
				width: 16px; height: 16px;
				accent-color: var(--ink);
			}

			.overrides .btn {
				margin-top: 0.75rem;
				font-size: 13px;
				padding: 5px 14px;
			}

			.hint-prose {
				margin: 0.75rem 0;
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--muted);
			}

			.copy-row {
				display: flex;
				align-items: stretch;
				gap: 0.5rem;
			}
			.copy-row .cmd {
				flex: 1;
				margin: 0;
				font-size: 12.5px;
				background: var(--ink);
				color: var(--bg);
				border: none;
			}
			.copy-row .cmd code { color: inherit; background: transparent; }

			#copy-btn {
				font-family: var(--font-display);
				font-size: 13px;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding: 0 14px;
				background: transparent;
				color: var(--ink);
				border: 1px solid var(--ink);
				cursor: pointer;
			}
			#copy-btn:hover { background: var(--mark); color: var(--on-mark); }

			@media (max-width: 640px) {
				.signals { grid-template-columns: repeat(2, 1fr); }
				.computed { grid-template-columns: repeat(2, 1fr); }
				.pick-stats { grid-template-columns: repeat(2, 1fr); }
				.control-row { grid-template-columns: 1fr; gap: 0.25rem; }
				.brief-head { grid-template-columns: 1fr; align-items: start; }
				.brief-meta { padding-bottom: 0; }
				.forecast-row {
					grid-template-columns: 1fr auto;
					grid-template-rows: auto auto;
					row-gap: 0.15rem;
					column-gap: 0.5rem;
				}
				.forecast-when { grid-row: 1; grid-column: 1 / -1; font-size: 11px; }
				.forecast-title { grid-row: 2; grid-column: 1; font-size: 17px; }
				.forecast-num { grid-row: 2; grid-column: 2; align-self: baseline; }
				#back-to-today { margin-left: 0; margin-top: 0.25rem; }
			}
		</style>
	</body>
</html>
