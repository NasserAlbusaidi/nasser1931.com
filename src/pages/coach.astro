---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import coach from '../data/coach.json';
import bank from '../data/workout-bank.json';
import { buildPublicForecast } from '../lib/public-coach.mjs';
import '../styles/coach.css';
const forecast = buildPublicForecast(coach, bank);
const current = forecast[0];
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Cycling coach — Nasser Al Busaidi" description="A daily cycling recommendation and a four-day training outlook. A personal software project by Nasser Al Busaidi." /></head>
  <body>
    <Header variant="compact" />
    <main id="main-content" tabindex="-1" class="coach-page">
      <header class="coach-intro"><div><p class="coach-eyebrow">A personal training project</p><h1>Cycling coach<span>.</span></h1><p>The next ride, with a little more thought behind it.</p></div><a href="/field">Training log <span aria-hidden="true">→</span></a></header>
      {current ? <div class="coach-dashboard">
        <section class="recommendation" aria-labelledby="recommendation-title">
          <p class="coach-eyebrow">Recorded recommendation · <time datetime={current.date}>{current.label}</time></p>
          <h2 id="recommendation-title">{current.title}<span>.</span></h2>
          <p class="recommendation-description">{current.description}</p>
          {(current.duration || current.targetIf || current.targetTss) && <dl class="workout-stats">
            {current.duration && <div><dt>Duration</dt><dd>{current.duration}<small> min</small></dd></div>}
            {current.targetIf && <div><dt>Target intensity factor</dt><dd>{current.targetIf.toFixed(2)}</dd></div>}
            {current.targetTss && <div><dt>Target training stress</dt><dd>{current.targetTss}</dd></div>}
          </dl>}
          <div class="coach-explanation"><h3>How it works</h3><p>A small rule-based engine combines my cycling schedule with recovery inputs to select a session from a workout library. This page shares the recommendation; the inputs and controls stay off the page.</p><p>It is built around my own training, and updates when a new snapshot arrives.</p></div>
        </section>
        <section class="outlook" aria-labelledby="outlook-title">
          <h2 id="outlook-title">Four-day outlook</h2>
          <ol class="outlook-list">{forecast.map(day => <li>
            {day.kind === 'rest' ? <div class="outlook-rest"><time datetime={day.date}>{day.label}</time><strong>{day.title}</strong><span>{day.projected ? 'Projected' : 'Recorded'}</span></div> : <details open={!day.projected}>
              <summary><span class="outlook-date"><time datetime={day.date}>{day.label}</time><span>{day.projected ? 'Projected' : 'Recorded'}</span></span><strong>{day.title}</strong>{day.duration && <span class="outlook-duration">{day.duration} min</span>}</summary>
              <p>{day.description}</p>
              {day.targetIf && <p class="outlook-target">Target intensity factor: {day.targetIf.toFixed(2)}</p>}{day.targetTss && <p class="outlook-target">Target training stress: {day.targetTss}</p>}
            </details>}
          </li>)}</ol>
          <p class="outlook-note">Future sessions use the schedule and a moderate-recovery baseline. They are provisional, not predictions of how I will feel.</p>
        </section>
      </div> : <p class="coach-empty">The latest recommendation is unavailable. The <a href="/field">training log</a> is still here.</p>}
    </main>
    <Footer />
  </body>
</html>
