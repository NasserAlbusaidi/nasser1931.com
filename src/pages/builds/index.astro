---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import buildsData from '../../data/builds.json';
import '../../styles/work.css';

type Build = {
	slug: string;
	name: string;
	year: number;
	status: 'live' | 'wip' | 'shipped' | 'parked';
	summary: string;
	stack: string[];
	url: string | null;
	repo: string | null;
	featured: boolean;
};

const STATUS_ORDER: Record<Build['status'], number> = {
	live: 0,
	wip: 1,
	shipped: 2,
	parked: 3,
};

const builds: Build[] = [...(buildsData.builds as Build[])].sort((a, b) => {
	const s = STATUS_ORDER[a.status] - STATUS_ORDER[b.status];
	if (s !== 0) return s;
	if (b.year !== a.year) return b.year - a.year;
	return a.name.localeCompare(b.name);
});

const statusLabel: Record<Build['status'], string> = {
	live: 'Live', wip: 'In progress', shipped: 'Published', parked: 'On hold',
};
const selectedSlugs = ['rihla', 'coach-engine', 'einsteins-travel-bureau'];
const selected = selectedSlugs.flatMap(slug => builds.filter(build => build.slug === slug));
const archived = (build: Build) => build.status === 'parked' || build.status === 'shipped';
const moreProjects = builds.filter(build => !selectedSlugs.includes(build.slug) && !archived(build));
const archive = builds.filter(build => !selectedSlugs.includes(build.slug) && archived(build));
const projectStories: Record<string, { lead: string; detail: string; category: string }> = {
	rihla: {
		lead: 'For the plans we make together.',
		detail: 'Groups, events, and shared expenses in one app. Designed to work offline, with fewer transfers needed to settle up.',
		category: 'Everyday life',
	},
	'coach-engine': {
		lead: 'A little more context before the next ride.',
		detail: 'A cycling briefing that turns recovery signals into a workout suggestion. The reasoning is there to read, alongside the recommendation.',
		category: 'Software × cycling',
	},
	'einsteins-travel-bureau': {
		lead: 'A travel agency for spacetime.',
		detail: 'A time-dilation sandbox with brochures, boarding passes, and a multi-observer laboratory. Special and general relativity do the maths behind the trip.',
		category: 'An experiment in physics',
	},
};
const shortDescriptions: Record<string, string> = {
	'macrofactor-mcp': 'A local tool connecting nutrition and training data.',
	mizan: 'A local dashboard for Claude Code and Codex usage.',
	nasser1931: 'This personal website, built with Astro and Firebase.',
	'readiness-engine': 'A training-readiness score delivered to your calendar.',
	'invoice-ar': 'Arabic and English invoice PDFs from JSON.',
	'claude-md': 'A configuration guide and template for Claude Code.',
	omanclimate: 'A climate atlas for Oman built from public datasets.',
	'silent-creep': 'A personal study of training, eating, and weight.',
	'bite-pos': 'Restaurant menus, kitchen orders, and payments.',
	inventory: 'Warehouse stock movements, sales, and financial tracking.',
};
const updated = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${buildsData.updated}T00:00:00Z`));

// Prefer the live/site link; fall back to the repo. Null on both → non-link row.
const hrefFor = (b: Build) => b.url ?? b.repo ?? null;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const destinationLabel = (build: Build) => build.url ? (build.slug === 'coach-engine' ? 'Read the briefing' : 'View project') : 'View source';
const projectGroups = [
	{ id: 'more-projects', title: 'More from the workbench', number: '02', projects: moreProjects },
	{ id: 'archive', title: 'Archive', number: '03', projects: archive },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Work — Nasser Al Busaidi"
			description="Software for everyday life, cycling, and curious experiments. Projects by Nasser Al Busaidi."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="work-page">
			<header class="work-intro">
				<div><p class="work-eyebrow">From the observatory</p><h1>Work<span>.</span></h1><p class="work-deck">Tools for everyday life, training, and the occasional trip through spacetime.</p></div>
				<div class="work-inventory"><span class="work-eyebrow">Project log</span><span>{builds.length} projects</span><p>Notes & statuses updated<br /><time datetime={buildsData.updated}>{updated}</time></p></div>
			</header>

			<section class="work-selected" aria-labelledby="selected-title">
				<div class="work-section-heading"><h2 id="selected-title"><span aria-hidden="true">01 /</span> A closer look</h2><span>Selected projects</span></div>
				{selected.map((project, index) => {
					const story = projectStories[project.slug];
					const href = hrefFor(project);
					const external = href && isExternal(href);
					return <article class:list={['work-feature', `work-feature-${project.slug}`]} id={project.slug} aria-labelledby={`${project.slug}-title`}>
						<div class="work-feature-identity"><span class="work-project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><p class="work-eyebrow">{story.category}</p><h3 id={`${project.slug}-title`}>{project.name}</h3><div class="work-project-meta"><span>{project.year}</span><span class:list={['work-status', project.status === 'wip' && 'work-status-progress']}>{statusLabel[project.status]}</span></div></div></div>
						<div class="work-feature-story"><p class="work-project-lead">{story.lead}</p><p class="work-project-description">{story.detail}</p><div class="work-feature-footer"><span class="work-stack">{project.stack.join(' · ')}</span>{href && <a class="work-project-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{destinationLabel(project)}<span aria-hidden="true">↗</span>{external && <span class="work-sr-only"> (opens in a new tab)</span>}</a>}</div></div>
					</article>;
				})}
			</section>

			{projectGroups.map(group => group.projects.length > 0 && <section class="work-project-group" aria-labelledby={`${group.id}-title`}>
				<div class="work-section-heading"><h2 id={`${group.id}-title`}><span aria-hidden="true">{group.number} /</span> {group.title}</h2><span>{group.projects.length} projects</span></div>
				<ul class="work-project-list">{group.projects.map(project => {
					const href = hrefFor(project);
					const external = href && isExternal(href);
					const Tag = href ? 'a' : 'div';
					return <li id={project.slug}><Tag class="work-project-row" href={href ?? undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
						<span class="work-row-year">{project.year}</span><div class="work-row-title"><h3>{project.name}</h3>{project.stack.length > 0 && <span class="work-stack">{project.stack.join(' · ')}</span>}</div><p class="work-row-description">{shortDescriptions[project.slug] ?? project.summary}</p><div class="work-row-end"><span class:list={['work-status', project.status === 'wip' && 'work-status-progress']}>{statusLabel[project.status]}</span>{href && <span class="work-row-destination">{destinationLabel(project)} <span aria-hidden="true">↗</span>{external && <span class="work-sr-only"> (opens in a new tab)</span>}</span>}</div>
					</Tag></li>;
				})}</ul>
			</section>)}
		</main>
		<Footer />
	</body>
</html>
