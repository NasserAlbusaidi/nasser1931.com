---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import buildsData from '../../data/builds.json';
import ProjectPreview from '../../components/ProjectPreview.astro';
import '../../styles/work.css';

type Build = (typeof buildsData.builds)[number];
const builds = buildsData.builds;
const selectedSlugs = ['rihla', 'silent-creep', 'einsteins-travel-bureau', 'coach-engine'];
const selected = selectedSlugs.flatMap(slug => builds.filter(build => build.slug === slug));
const moreProjects = builds.filter(build => !selectedSlugs.includes(build.slug));
const projectStories: Record<string, { lead: string; detail: string; category: string }> = {
  'silent-creep': {
    lead: 'What actually changed over 1,300 days?',
    detail: 'A study of my own training, food intake, and body weight. Six tests, a Bayesian model, and a record long enough to question my assumptions.',
    category: 'Personal research',
  },
	rihla: {
		lead: 'For the plans we make together.',
		detail: 'Groups, events, and shared expenses in one app. Designed to work offline, with fewer transfers needed to settle up.',
		category: 'Everyday life',
	},
	'coach-engine': {
		lead: 'A little more context before the next ride.',
		detail: 'A cycling briefing that turns recovery signals into a workout suggestion. The public page shares the recommendation and a provisional four-day outlook.',
		category: 'Software × cycling',
	},
	'einsteins-travel-bureau': {
		lead: 'A travel agency for spacetime.',
		detail: 'A time-dilation sandbox with brochures, boarding passes, and a multi-observer laboratory. Special and general relativity do the maths behind the trip.',
		category: 'An experiment in physics',
	},
};
const shortDescriptions: Record<string, string> = {
	'macrofactor-mcp': 'A local tool connecting nutrition and training data.',
	mizan: 'A local dashboard for Claude Code and Codex usage.',
	nasser1931: 'This personal website, built with Astro and Firebase.',
	'readiness-engine': 'A training-readiness score delivered to your calendar.',
	'invoice-ar': 'Arabic and English invoice PDFs from JSON.',
	'claude-md': 'A configuration guide and template for Claude Code.',
	omanclimate: 'A climate atlas for Oman built from public datasets.',
	'silent-creep': 'A personal study of training, eating, and weight.',
	'bite-pos': 'Open-source restaurant software for menus, kitchen orders, and payments.',
	inventory: 'Warehouse stock movements, sales, and financial tracking.',
};
// Prefer the live/site link; fall back to the repo. Null on both → non-link row.
const hrefFor = (b: Build) => b.url ?? b.repo ?? null;
const storesFor = (build: Build) => 'stores' in build ? build.stores ?? [] : [];
const isExternal = (href: string) => /^https?:\/\//.test(href);
const destinationLabel = (build: Build) => build.slug === 'silent-creep' ? 'Read the study' : build.slug === 'einsteins-travel-bureau' ? 'Explore the bureau' : build.url ? (build.slug === 'coach-engine' ? 'Read the briefing' : 'View project') : 'View source';
const projectGroups = [
	{ id: 'more-projects', title: 'Tools & open source', projects: moreProjects },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Nasser Al Busaidi"
			description="Software for everyday life, cycling, and curious experiments. Projects by Nasser Al Busaidi."
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="work-page">
			<header class="work-intro">
				<div><p class="work-eyebrow">Built out of curiosity</p><h1>Projects<span>.</span></h1><p class="work-deck">Personal apps, a study of my own training, and experiments worth sharing.</p></div>
				<div class="work-inventory"><span class="work-eyebrow">Project log</span><span>{builds.length} projects</span><p>Apps, research, and open source.</p></div>
			</header>

			<section class="work-selected" aria-labelledby="selected-title">
				<div class="work-section-heading"><h2 id="selected-title">A closer look</h2><span>Selected projects</span></div>
				{selected.map((project) => {
					const story = projectStories[project.slug];
					const href = hrefFor(project);
					const stores = storesFor(project);
					const external = href && isExternal(href);
					return <article class:list={['work-feature', `work-feature-${project.slug}`]} id={project.slug} aria-labelledby={`${project.slug}-title`}>
						<div class="work-feature-identity"><div><p class="work-eyebrow">{story.category}</p><h3 id={`${project.slug}-title`}>{project.name}</h3><div class="work-project-meta"><span class="work-status">{project.label}</span></div></div></div>
						<div class="work-feature-story"><ProjectPreview project={project.slug} /><p class="work-project-lead">{story.lead}</p><p class="work-project-description">{story.detail}</p><div class="work-feature-footer"><span class="work-stack">{project.stack.join(' · ')}</span><div class="work-destinations">{stores.length > 0 ? <div class="work-store-links">{stores.map(store => <a class="work-project-link" href={store.url} target="_blank" rel="noopener">{store.label}<span aria-hidden="true">↗</span><span class="work-sr-only"> (opens in a new tab)</span></a>)}</div> : href && <a class="work-project-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{destinationLabel(project)}<span aria-hidden="true">{external ? '↗' : '→'}</span>{external && <span class="work-sr-only"> (opens in a new tab)</span>}</a>}{project.url && project.repo && <a class="work-source-link" href={project.repo} target="_blank" rel="noopener">View source<span class="work-sr-only"> (opens in a new tab)</span></a>}</div></div></div>
					</article>;
				})}
			</section>

			{projectGroups.map(group => group.projects.length > 0 && <section class="work-project-group" aria-labelledby={`${group.id}-title`}>
				<div class="work-section-heading"><h2 id={`${group.id}-title`}>{group.title}</h2><span>{group.projects.length} projects</span></div>
				<ul class="work-project-list">{group.projects.map(project => {
					const href = hrefFor(project);
					const external = href && isExternal(href);
					const Tag = href ? 'a' : 'div';
					return <li id={project.slug}><Tag class="work-project-row" href={href ?? undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
						<div class="work-row-title"><h3>{project.name}</h3>{project.stack.length > 0 && <span class="work-stack">{project.stack.join(' · ')}</span>}</div><p class="work-row-description">{shortDescriptions[project.slug] ?? project.summary}</p><div class="work-row-end"><span class="work-status">{project.label}</span>{href && <span class="work-row-destination">{destinationLabel(project)} <span aria-hidden="true">{external ? '↗' : '→'}</span>{external && <span class="work-sr-only"> (opens in a new tab)</span>}</span>}</div>
					</Tag></li>;
				})}</ul>
			</section>)}
		</main>
		<Footer />
	</body>
</html>
