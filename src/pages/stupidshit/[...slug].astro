---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';

export async function getStaticPaths() {
	const entries = await getCollection('stupidshit');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'stupidshit'>;

const entry = Astro.props;
const { Content } = await render(entry);
---

<Entry title={entry.data.title} summary={entry.data.summary} date={entry.data.date} eyebrow="stupidshit">
	<Content />
</Entry>
