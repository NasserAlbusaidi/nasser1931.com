---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import EntryIndex from '../../components/EntryIndex.astro';
const entries = (await getCollection('stupidshit')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const journal = entries.map(entry => ({ ...entry.data, href: `/stupidshit/${entry.id}/` }));
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Notes — Nasser Al Busaidi" description="Small ideas, oddities, and things worth writing down." /></head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="interior">
      <PageIntro title="Notes" eyebrow="02 / Notes & observations" description="Small ideas, oddities, and things worth writing down." meta={`${entries.length} ${entries.length === 1 ? 'entry' : 'entries'}`} />
      <section aria-labelledby="journal-title">
        <div class="interior-section-head"><h2 id="journal-title">The notebook</h2><a href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a></div>
        {entries.length ? <EntryIndex entries={journal} /> : <p class="interior-empty">No notes here yet. The next odd idea will have a home.</p>}
      </section>
    </main>
    <Footer />
  </body>
</html>
