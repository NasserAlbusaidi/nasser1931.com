---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomePulse from '../components/HomePulse.astro';
import paperLog from '../data/paper-log.json';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="display">Nasser <span class="family">Al Busaidi</span></h1>
				<p class="tagline">
					<em>Engineer in Muscat. Triathlete on the side. Writes long things, occasionally retracts them on the page.</em>
				</p>
				<p class="meta">
					<span>Muscat, Oman</span>
				</p>
			</section>

			<HomePulse />

			<section class="entries-block">
				<h2 class="section-head">paper</h2>
				<ul class="entries">
					<li>
						<time datetime="2026-04">2026-04</time>
						<a href="/paper">The Silent Creep</a>
						<span class="summary">— 1,300 days, six guardrails, one quiet caloric drift.</span>
						{paperLog?.last_edit && (
							<span class="entry-edited">
								<span class="dot">·</span>
								edited <span data-iso={paperLog.last_edit}>recently</span>
							</span>
						)}
					</li>
				</ul>
			</section>

			<section class="entries-block">
				<h2 class="section-head">field</h2>
				<ul class="entries placeholder">
					<li>
						<span class="muted-row">First field entries land soon — race results, training milestones, hinge moments.</span>
					</li>
				</ul>
			</section>

			<section class="entries-block">
				<h2 class="section-head">stupidshit</h2>
				<ul class="entries placeholder">
					<li>
						<span class="muted-row">A folder for one-off oddities and weird hacks that warrant a permanent URL.</span>
					</li>
				</ul>
			</section>

		</main>
		<Footer />

		<style>
			main {
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: 4rem 1.25rem 2rem;
			}

			.hero {
				margin: 1rem 0 4rem;
			}

			.display {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: clamp(56px, 8vw, 96px);
				line-height: 0.95;
				letter-spacing: -0.025em;
				font-variation-settings: "opsz" 144;
				margin: 0 0 0.5rem;
			}

			.family {
				color: var(--accent);
			}

			.tagline {
				font-family: var(--font-body);
				font-size: 19px;
				line-height: 1.55;
				color: var(--ink);
				max-width: 38ch;
				margin: 0 0 1rem;
			}

			.tagline em {
				font-style: italic;
			}

			.meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				line-height: 1.5;
				color: var(--muted);
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin: 0;
			}

			.meta .dot {
				color: var(--rule);
			}

			.entries-block {
				margin: 2.5rem 0;
			}

			.section-head {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--muted);
				margin: 0 0 0.5rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.entries.placeholder li {
				border-bottom: none;
				padding: 0.5em 0;
			}

			.muted-row {
				color: var(--muted);
				font-size: 15px;
				font-style: italic;
			}

			.entry-edited {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				margin-left: 0.4em;
			}

			.entry-edited .dot {
				color: var(--rule);
				margin-right: 0.4em;
			}
		</style>
	</body>
</html>
