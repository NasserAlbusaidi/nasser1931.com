---
import { Picture } from 'astro:assets';
import Earth from '../assets/earth-arabia.png';
import ProjectPreview from '../components/ProjectPreview.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadingSource from '../components/ReadingSource.astro';
import ShelfSpines from '../components/ShelfSpines.astro';
import RaceCard from '../components/RaceCard.astro';
import reading from '../data/reading.json';
import training from '../data/training.json';
import builds from '../data/builds.json';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';

const books = [...reading.currently_reading, ...reading.finished]
  .filter((book, index, all) => all.findIndex(other => other.title === book.title && other.author === book.author) === index)
  .slice(0, 5);
// last_ride is chosen from a wider window than `recent`; older snapshots lack it.
const ride = ('last_ride' in training ? training.last_ride : null) ?? training.recent.find(activity => activity.type === 'bike');
const strength = training.recent.find(activity => activity.type === 'workout');
const rihla = builds.builds.find(build => build.slug === 'rihla');
const shortProjects = ['silent-creep', 'einsteins-travel-bureau'].flatMap(slug => builds.builds.filter(build => build.slug === slug));
const summaries: Record<string, string> = {
  'silent-creep': 'A 1,300-day study of my own training, eating, and weight. Built with Python and PyMC.',
  'einsteins-travel-bureau': 'Plan a trip near the speed of light and see how differently time passes.',
};
const date = (value: string | Date) => {
  const parsed = value instanceof Date ? value : new Date(value);
  return Number.isFinite(parsed.getTime()) ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(parsed) : null;
};
const duration = (minutes: number | null) => minutes == null ? null : minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="home">
      <section class="introduction" aria-labelledby="intro-title">
        <div class="intro-content">
          <div class="intro-copy">
            <p class="eyebrow">A personal observatory</p>
            <h1 id="intro-title">Nasser<br /><span>Al Busaidi<span class="name-stop">.</span></span></h1>
            <p class="intro-line">I build software, ride bikes, and get curious about the details.</p>
            <p class="intro-description">Senior software engineer. This is my personal home for side projects and life outside work.</p>
            <div class="intro-links"><a class="home-button primary" href="#work">Explore projects <span aria-hidden="true">↓</span></a><a class="home-button" href="mailto:nasserbusaidi@gmail.com">Say hello</a></div>
          </div>
          <figure class="home-world">
            <div class="globe-frame">
              <Picture src={Earth} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 640, 960, 1254]} sizes="(max-width: 600px) 90vw, 540px" quality={75} loading="eager" fetchpriority="high" />
              <span class="muscat-pin" aria-hidden="true"></span><span class="muscat-label" aria-hidden="true">Muscat</span>
            </div>
            <figcaption><span class="eyebrow">Home base</span><span>Muscat, Oman</span><small>An imagined view of Earth, facing Arabia</small></figcaption>
          </figure>
        </div>
      </section>
      <div class="home-content">
        <aside class="now-strip" aria-label="What I’m up to">
          <div class="now-heading"><span class="eyebrow">Now</span><span>A few things in motion.</span></div>
          <a class="now-item" href="#rihla"><span class="eyebrow">Shipped</span><strong>Rihla — on iOS &amp; Android</strong><span>App Store · Google Play <span aria-hidden="true">↓</span></span></a>
          {ride && <a class="now-item" href="/field"><span class="eyebrow">Riding</span><strong>{ride.distance_km != null ? `${ride.distance_km} km` : 'The latest ride'}</strong><span>{date(ride.date)}{ride.duration_min != null && ` · ${duration(ride.duration_min)}`} <span aria-hidden="true">→</span></span></a>}
          {books[0] && <a class="now-item" href="/reading"><span class="eyebrow">{reading.currently_reading.length ? 'Reading' : 'From the shelf'}</span><strong>{books[0].title}</strong><span>{books[0].author} <span aria-hidden="true">→</span></span></a>}
        </aside>

        <section id="work" class="work-section" aria-labelledby="work-title">
          <div class="section-heading"><h2 id="work-title">Selected projects</h2><a class="quiet-link" href="/builds">All {builds.builds.length} projects <span aria-hidden="true">→</span></a></div>
          <article id="rihla" class="rihla-showcase" aria-labelledby="rihla-title">
            <div class="rihla-copy">
              <div class="project-topline"><span class="eyebrow">Software × everyday life</span><span class="project-badge">Shipped</span></div>
              <h3 id="rihla-title">{rihla?.name ?? 'Rihla'}</h3>
              <p class="project-deck">For the plans you make together.</p>
              <p class="project-description">Groups, events, and shared expenses in one app. Built to work offline, and to settle up with fewer transfers.</p>
            </div>
            <ProjectPreview project="rihla" variant="showcase" />
            <div class="rihla-actions">
              <div class="project-store-links">{rihla?.stores?.map(store => <a class="home-button" href={store.url}>{store.label} <span aria-hidden="true">↗</span></a>)}</div>
              <div class="project-bottom"><span>{rihla?.stack.join(' · ')}</span>{rihla?.repo && <a href={rihla.repo}>Source <span aria-hidden="true">↗</span></a>}</div>
            </div>
          </article>

          <div class="supporting-projects">
            <RaceCard />
            {shortProjects.map(project => <article class="supporting-project" aria-labelledby={`home-${project.slug}`}>
              <ProjectPreview project={project.slug} variant="card" />
              <div class="supporting-copy"><p class="eyebrow">{project.slug === 'silent-creep' ? 'Personal research · Published' : 'An experiment in physics'}</p><h3 id={`home-${project.slug}`}>{project.name}</h3><p class="project-description">{summaries[project.slug]}</p></div>
              <div class="project-bottom"><span>{project.stack.join(' · ')}</span><a href={project.url ?? project.repo ?? '/builds'}>{project.slug === 'silent-creep' ? 'Read the study' : 'Try the demo'} <span aria-hidden="true">{project.url?.startsWith('/') ? '→' : '↗'}</span></a></div>
            </article>)}
          </div>
        </section>

        <section class="life-section" id="life" aria-labelledby="life-title">
          <div class="life-copy"><p class="eyebrow">Life · Cycling</p><h2 id="life-title">Out for<br /><em>the long ride.</em></h2><p>Cycling, strength sessions, and a reason to close the laptop.</p><a class="text-link" href="/field">View the training log <span aria-hidden="true">→</span></a></div>
          <div class="ride-note">
            <span class="eyebrow">Last recorded ride</span>
            {ride ? <><div class="ride-distance">{ride.distance_km != null && <>{ride.distance_km}<span>km</span></>}</div><p class="ride-name">{ride.name}</p><p class="ride-meta"><time datetime={ride.date}>{date(ride.date)}</time>{ride.duration_min != null && <span>{duration(ride.duration_min)}</span>}</p></> : <p class="ride-name">No ride in this snapshot.</p>}
            <dl class="ride-stats"><div><dt>Hours in recorded week</dt><dd>{training.weekly_hours} <small>h</small></dd></div><div><dt>Training load, same week</dt><dd>{training.weekly_tss} <small>TSS</small></dd></div>{strength && <div><dt>{strength.name} · {date(strength.date)}</dt><dd>{duration(strength.duration_min)}</dd></div>}</dl>
            <p class="snapshot-date">Snapshot updated <time datetime={training.updated}>{date(training.updated)}</time></p>
          </div>
        </section>

        <section aria-labelledby="reading-title" class="reading-section">
          <div class="section-heading"><h2 id="reading-title">On the shelf</h2><a class="quiet-link" href="/reading">Reading list <span aria-hidden="true">→</span></a></div>
          <p class="shelf-intro">What I’m reading now, then the most recent finishes.</p>
          <ShelfSpines /><ReadingSource />
        </section>
        <div class="closing-note"><p>Something here sparked a thought?</p><a class="home-button primary" href="mailto:nasserbusaidi@gmail.com">Say hello <span aria-hidden="true">→</span></a></div>
      </div>
    </main>
    <Footer />
  </body>
</html>
