---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomePulse from '../components/HomePulse.astro';
import paperLog from '../data/paper-log.json';
import reading from '../data/reading.json';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Recent field + stupidshit entries, merged & sorted by date desc.
const fieldEntries = await getCollection('field');
const stupidEntries = await getCollection('stupidshit');
const log = [
	...fieldEntries.map((e) => ({ ...e, section: 'field' })),
	...stupidEntries.map((e) => ({ ...e, section: 'stupidshit' })),
]
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
	.slice(0, 6);

const fmtDate = (d: Date) => {
	const y = d.getUTCFullYear();
	const m = String(d.getUTCMonth() + 1).padStart(2, '0');
	const day = String(d.getUTCDate()).padStart(2, '0');
	return `${y}-${m}-${day}`;
};

// Fall back to recently finished if nothing is in-progress.
const readingShelf =
	reading.currently_reading?.length > 0
		? reading.currently_reading.slice(0, 3).map((b) => ({ ...b, state: 'in_progress' }))
		: reading.finished.slice(0, 3).map((b) => ({ ...b, state: 'finished' }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="board">
			<HomePulse />

			<section class="lead">
				<div class="lead-top">
					<span class="label">The paper</span>
					<span class="lead-meta">
						{paperLog?.last_edit && (
							<>edited <span data-iso={paperLog.last_edit}>recently</span></>
						)}
						{paperLog?.commits_7d > 0 && (
							<> · {paperLog.commits_7d} {paperLog.commits_7d === 1 ? 'commit' : 'commits'} this week</>
						)}
					</span>
				</div>
				<h1 class="lead-title title-hero">
					<a href="/paper">The <span class="hl">silent</span> creep</a>
				</h1>
				<p class="lead-dek">
					A +387 kcal/day drift erased a 67%-efficient training block. 1,300 days of
					training, eating, and weight data, walked through six guardrails.
				</p>
				<p class="lead-byline">Nasser Al Busaidi · Muscat · N=1</p>
				<a href="/paper" class="btn">Read the paper</a>
			</section>

			<section class="log">
				<div class="section-top">
					<span class="label">Log</span>
					<span class="section-links">
						<a href="/field">field</a> · <a href="/stupidshit">stupidshit</a>
					</span>
				</div>
				{log.length === 0 ? (
					<p class="empty">Nothing logged yet.</p>
				) : (
					<ul class="results">
						{log.map((entry) => (
							<li>
								<a class="row" href={`/${entry.section}/${entry.id}`}>
									<time class="row-date" datetime={new Date(entry.data.date).toISOString()}>
										{fmtDate(new Date(entry.data.date))}
									</time>
									<span class="row-body">
										<span class="row-title">{entry.data.title}</span>
										{entry.data.summary && <span class="row-summary">{entry.data.summary}</span>}
									</span>
									<span class="row-meta">{entry.section}</span>
								</a>
							</li>
						))}
					</ul>
				)}
			</section>

			<section class="shelf">
				<div class="section-top">
					<span class="label">
						{readingShelf[0]?.state === 'in_progress' ? 'Currently reading' : 'Recently finished'}
					</span>
					<span class="section-links"><a href="/reading">all reading</a></span>
				</div>
				{readingShelf.length === 0 ? (
					<p class="empty">Shelf is empty between books.</p>
				) : (
					<ul class="shelf-list">
						{readingShelf.map((book) => (
							<li>
								<span class="book">
									<em>{book.title}</em>
									{book.author && <span class="book-author"> — {book.author}</span>}
								</span>
								<span class="book-meta">
									{book.state === 'in_progress'
										? 'in progress'
										: book.rating
											? `${book.rating}/5`
											: '—'}
								</span>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />

		<style>
			.board {
				max-width: var(--container-wide);
				margin: 0 auto;
				padding: 1.5rem 1.5rem 4rem;
				display: flex;
				flex-direction: column;
				gap: 3.5rem;
			}

			@media (max-width: 720px) {
				.board { padding: 1rem 1rem 3rem; gap: 2.5rem; }
			}

			/* ---- lead: the paper ---- */
			.lead-top,
			.section-top {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--ink);
				margin-bottom: 1rem;
			}

			.lead-top .label,
			.section-top .label {
				color: var(--ink);
			}

			.lead-meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
			}

			.section-links {
				font-family: var(--font-display);
				font-size: 14px;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.section-links a {
				color: var(--muted);
				text-decoration: none;
				padding: 1px 4px;
			}

			.section-links a:hover {
				color: var(--on-mark);
				background: var(--mark);
			}

			.lead-title {
				margin: 0 0 1rem;
				max-width: 14ch;
			}

			.lead-title a {
				color: var(--ink);
				text-decoration: none;
			}

			.lead-title a:hover {
				background: transparent;
				color: var(--ink);
				text-decoration: underline;
				text-decoration-thickness: 4px;
				text-underline-offset: 6px;
			}

			/* The one entrance moment: the marker wipes in behind the word.
			   The text starts at --ink and crossfades to --on-mark mid-wipe —
			   in dark mode a static --on-mark (#111) would be invisible on the
			   near-black page during the animation delay. */
			.hl {
				position: relative;
				z-index: 0;
				padding: 0 0.06em;
				color: var(--ink);
				animation: hl-ink 200ms 300ms ease-out both;
			}

			.hl::before {
				content: '';
				position: absolute;
				inset: 0;
				background: var(--mark);
				z-index: -1;
				transform-origin: left;
				animation: hl-wipe 400ms 150ms ease-out both;
			}

			@keyframes hl-wipe {
				from { transform: scaleX(0); }
				to { transform: scaleX(1); }
			}

			@keyframes hl-ink {
				from { color: var(--ink); }
				to { color: var(--on-mark); }
			}

			.lead-dek {
				font-family: var(--font-ui);
				font-size: 17px;
				line-height: 1.55;
				color: var(--ink);
				max-width: 52ch;
				margin: 0 0 0.75rem;
			}

			.lead-byline {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				margin: 0 0 1.5rem;
			}

			/* ---- reading shelf ---- */
			.shelf-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.shelf-list li {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: 0.55em 0.5em;
				border-bottom: 1px solid var(--rule);
			}

			.book {
				font-family: var(--font-prose);
				font-size: 16px;
				color: var(--ink);
			}

			.book em {
				font-style: italic;
			}

			.book-author {
				color: var(--muted);
			}

			.book-meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				white-space: nowrap;
			}

			.empty {
				font-family: var(--font-ui);
				font-size: 15px;
				color: var(--muted);
				margin: 1rem 0;
			}
		</style>

		<!-- Compute "edited X ago" client-side so static HTML doesn't go stale. -->
		<script is:inline>
			(function () {
				function format(iso) {
					if (!iso) return '';
					var now = Date.now();
					var then = Date.parse(iso);
					if (isNaN(then)) return '';
					var diff = Math.max(0, now - then);
					var min = 60 * 1000,
						hr = 60 * min,
						day = 24 * hr,
						week = 7 * day,
						month = 30 * day;
					if (diff < hr) return Math.max(1, Math.round(diff / min)) + 'm ago';
					if (diff < day) return Math.round(diff / hr) + 'h ago';
					if (diff < week) return Math.round(diff / day) + 'd ago';
					if (diff < month) return Math.round(diff / week) + 'w ago';
					return Math.round(diff / month) + 'mo ago';
				}
				document.querySelectorAll('.lead [data-iso]').forEach(function (el) {
					var label = format(el.getAttribute('data-iso'));
					if (label) el.textContent = label;
				});
			})();
		</script>
	</body>
</html>
