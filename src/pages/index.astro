---
import { Picture } from 'astro:assets';
import Earth from '../assets/earth-arabia.png';
import ProjectPreview from '../components/ProjectPreview.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadingSource from '../components/ReadingSource.astro';
import ShelfSpines from '../components/ShelfSpines.astro';
import RaceCard from '../components/RaceCard.astro';
import WorldsCard from '../components/WorldsCard.astro';
import SkyClosing from '../components/SkyClosing.astro';
import Orrery from '../components/Orrery.astro';
import { getCollection } from 'astro:content';
import reading from '../data/reading.json';
import nextRace from '../data/next-race.json';
import { races } from '../lib/races';
import { buildOrrery, latestDate } from '../lib/orrery';
import { buildReadingSeries } from '../lib/reading-series.mjs';
import builds from '../data/builds.json';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/home.css';

const allBooks = [...reading.currently_reading, ...reading.finished]
  .filter((book, index, all) => all.findIndex(other => other.title === book.title && other.author === book.author) === index);
const books = allBooks.slice(0, 5);
const upcoming = (nextRace as { race: { date: string; name: string } | null }).race;
const latestFinish = races.find(race => race.status === 'finished');
const skyPhotos = (await getCollection('sky')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestSky = skyPhotos[0];
const rihla = builds.builds.find(build => build.slug === 'rihla');
const einstein = builds.builds.find(build => build.slug === 'einsteins-travel-bureau');
// The solar system: each section's size and speed come from the data it already shows.
const day = (value: Date) => value.toISOString().slice(0, 10);
const notes = await getCollection('stupidshit');
const readingTrack = buildReadingSeries(reading).filter(track => track.finishedCount + track.currentCount > 0).sort((a, b) => b.currentCount - a.currentCount)[0];
const inProgress = (track: NonNullable<typeof readingTrack>) => track.books.filter(book => book.status === 'current')
  .reduce((sum, book) => sum + (reading.currently_reading.find(item => item.title === book.matchedTitle)?.progress ?? 0) / 100, 0);
const nowReading = reading.currently_reading[0];
const orrery = buildOrrery({
  projects: { count: builds.builds.length, changed: builds.updated, moons: [rihla, einstein].filter(build => !!build).map(build => ({ name: build.name, note: build.label })) },
  races: races.map(({ name, date, status }) => ({ name, date, status })),
  notes: { count: notes.length, changed: latestDate(notes.map(note => day(note.data.date))) },
  reading: {
    count: allBooks.length,
    changed: latestDate(reading.finished.map(book => book.finished)),
    current: nowReading ? { title: nowReading.title, progress: nowReading.progress } : null,
    series: readingTrack ? { name: readingTrack.name, total: readingTrack.total, done: readingTrack.finishedCount + inProgress(readingTrack) } : null,
  },
  sky: { count: skyPhotos.length, changed: latestSky ? day(latestSky.data.date) : null, latestTitle: latestSky?.data.title ?? null },
});
const date = (value: string | Date) => {
  const parsed = value instanceof Date ? value : new Date(value);
  return Number.isFinite(parsed.getTime()) ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(parsed) : null;
};
// Tells search engines which Nasser Al Busaidi this site belongs to. Only facts
// the site already states: name, role, city, and the footer profiles.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://nasser1931.com/#website', url: 'https://nasser1931.com/', name: SITE_TITLE, publisher: { '@id': 'https://nasser1931.com/#person' } },
    {
      '@type': 'Person', '@id': 'https://nasser1931.com/#person', name: 'Nasser Al Busaidi', url: 'https://nasser1931.com/',
      jobTitle: 'Senior software engineer', address: { '@type': 'PostalAddress', addressLocality: 'Muscat', addressCountry: 'OM' },
      sameAs: ['https://github.com/NasserAlbusaidi', 'https://www.linkedin.com/in/nasser-albusaidi-308642113/'],
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" class="home">
      <section class="introduction" aria-labelledby="intro-title">
        <div class="intro-content">
          <div class="intro-copy">
            <p class="eyebrow">A personal observatory</p>
            <h1 id="intro-title">Nasser<br /><span>Al Busaidi<span class="name-stop">.</span></span></h1>
            <p class="intro-line">I build software, ride bikes, and get curious about the details.</p>
            <p class="intro-description">Senior software engineer. This is my personal home for side projects and life outside work.</p>
            <div class="intro-links"><a class="home-button primary" href="#work">Explore projects <span aria-hidden="true">↓</span></a><a class="home-button" href="mailto:nasserbusaidi@gmail.com">Say hello</a></div>
          </div>
          <figure class="home-world">
            <Orrery {...orrery}>
              <Picture src={Earth} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 640, 960, 1254]} sizes="(max-width: 600px) 90vw, 540px" quality={75} loading="eager" fetchpriority="high" />
              <span class="muscat-pin" aria-hidden="true"></span><span class="muscat-label" aria-hidden="true">Muscat</span>
            </Orrery>
            <figcaption><span class="eyebrow">Home base</span><span>Muscat, Oman</span><small>This site as a solar system. Planet, ring, and sun textures by <a href="https://www.solarsystemscope.com/textures/" rel="noopener">Solar System Scope</a>, CC BY 4.0, based on NASA imagery.</small></figcaption>
          </figure>
        </div>
      </section>
      <div class="home-content">
        <aside class="now-strip" aria-label="What I’m up to">
          <div class="now-heading"><span class="eyebrow">Now</span><span>A few things in motion.</span></div>
          <a class="now-item" href="#rihla"><span class="eyebrow">Shipped</span><strong>Rihla — on iOS &amp; Android</strong><span>App Store · Google Play <span aria-hidden="true">↓</span></span></a>
          {upcoming ? <a class="now-item" href="/races"><span class="eyebrow">Racing next</span><strong>{upcoming.name}</strong><span>{date(upcoming.date)} <span aria-hidden="true">→</span></span></a>
            : latestFinish && <a class="now-item" href="/races"><span class="eyebrow">Last race</span><strong>{latestFinish.name}{latestFinish.total && ` · ${latestFinish.total}`}</strong><span>{date(latestFinish.date)} <span aria-hidden="true">→</span></span></a>}
          {books[0] && <a class="now-item" href="/reading"><span class="eyebrow">{reading.currently_reading.length ? 'Reading' : 'From the shelf'}</span><strong>{books[0].title}</strong><span>{books[0].author} <span aria-hidden="true">→</span></span></a>}
        </aside>

        <section id="work" class="work-section" aria-labelledby="work-title">
          <div class="section-heading"><h2 id="work-title">Selected projects</h2><a class="quiet-link" href="/builds">All {builds.builds.length} projects <span aria-hidden="true">→</span></a></div>
          <article id="rihla" class="rihla-showcase" aria-labelledby="rihla-title">
            <div class="rihla-copy">
              <div class="project-topline"><span class="eyebrow">Software × everyday life</span><span class="project-badge">Shipped</span></div>
              <h3 id="rihla-title">{rihla?.name ?? 'Rihla'}</h3>
              <p class="project-deck">For the plans you make together.</p>
              <p class="project-description">Groups, events, and shared expenses in one app. Built to work offline, and to settle up with fewer transfers.</p>
            </div>
            <ProjectPreview project="rihla" variant="showcase" />
            <div class="rihla-actions">
              <div class="project-store-links">{rihla?.stores?.map(store => <a class="home-button" href={store.url}>{store.label} <span aria-hidden="true">↗</span></a>)}</div>
              <div class="project-bottom"><span>{rihla?.stack.join(' · ')}</span>{rihla?.repo && <a href={rihla.repo}>Source <span aria-hidden="true">↗</span></a>}</div>
            </div>
          </article>

          <div class="supporting-projects">
            <RaceCard />
            {einstein && <article class="supporting-project" aria-labelledby="home-einstein">
              <ProjectPreview project={einstein.slug} variant="card" />
              <div class="supporting-copy"><p class="eyebrow">An experiment in physics</p><h3 id="home-einstein">{einstein.name}</h3><p class="project-description">Plan a trip near the speed of light and see how differently time passes.</p></div>
              <div class="project-bottom"><span>{einstein.stack.join(' · ')}</span><a href={einstein.url ?? einstein.repo ?? '/builds'}>Try the demo <span aria-hidden="true">↗</span></a></div>
            </article>}
            <WorldsCard />
          </div>
        </section>

        <section aria-labelledby="reading-title" class="reading-section">
          <div class="section-heading"><h2 id="reading-title">On the shelf</h2><a class="quiet-link" href="/reading">Reading list <span aria-hidden="true">→</span></a></div>
          <p class="shelf-intro">What I’m reading now, then the most recent finishes.</p>
          <ShelfSpines /><ReadingSource />
        </section>
        {latestSky ? <SkyClosing photo={latestSky} />
          : <div class="closing-note"><p>Something here sparked a thought?</p><a class="home-button primary" href="mailto:nasserbusaidi@gmail.com">Say hello <span aria-hidden="true">→</span></a></div>}
      </div>
    </main>
    <Footer />
  </body>
</html>
