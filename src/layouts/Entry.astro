---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	summary: string;
	date: Date;
	eyebrow: string;
}

const { title, summary, date, eyebrow } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — ${eyebrow}`} description={summary} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="entry-head">
					<p class="eyebrow">{eyebrow}</p>
					<h1>{title}</h1>
					<p class="meta">
						<FormattedDate date={date} />
					</p>
					<p class="summary"><em>{summary}</em></p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />

		<style>
			main {
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: 4rem 1.25rem 2rem;
			}

			.entry-head {
				margin: 0 0 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.eyebrow {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--accent);
				margin: 0 0 1rem;
			}

			h1 {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 36px;
				line-height: 1.1;
				letter-spacing: -0.02em;
				font-variation-settings: "opsz" 72;
				margin: 0 0 0.75rem;
			}

			.meta {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				margin: 0 0 0.75rem;
			}

			.summary {
				font-family: var(--font-body);
				font-size: 17px;
				line-height: 1.55;
				color: var(--muted);
				margin: 0;
			}

			.prose {
				font-family: var(--font-body);
				font-size: 17px;
				line-height: 1.65;
				color: var(--ink);
			}

			.prose :global(p) {
				margin: 0 0 1.1em;
			}

			.prose :global(h2) {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 24px;
				font-variation-settings: "opsz" 36;
				margin: 2em 0 0.5em;
			}

			.prose :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.prose :global(code) {
				font-family: var(--font-mono);
				font-size: 0.9em;
				background: var(--accent-soft);
				color: var(--accent);
				padding: 0.1em 0.4em;
				border-radius: var(--radius-md);
			}

			.prose :global(.stats) {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 13px;
				color: var(--muted);
				background: var(--surface);
				border: 1px solid var(--rule);
				border-radius: var(--radius-md);
				padding: 1em 1.2em;
				margin: 1.5em 0;
			}
		</style>
	</body>
</html>
