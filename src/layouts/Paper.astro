---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PaperLog from '../components/PaperLog.astro';
import paperLog from '../data/paper-log.json';

interface Frontmatter {
	title: string;
	description: string;
	subtitle?: string;
	byline?: string;
	eyebrow?: string;
	companion?: { href: string; label: string };
	image?: string;
	ogType?: 'website' | 'article';
	share?: boolean;
}

interface Props extends Frontmatter {
	frontmatter?: Frontmatter;
}

// Astro markdown layouts receive frontmatter under `Astro.props.frontmatter`.
// Direct .astro callers can pass these fields as top-level props instead.
const fm: Frontmatter = (Astro.props.frontmatter as Frontmatter) ?? (Astro.props as Frontmatter);
const {
	title,
	description,
	subtitle,
	byline,
	eyebrow = 'field report',
	companion,
	image,
	ogType = 'article',
	share = true,
} = fm;

const ogImage = image ? { src: image } : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} ogType={ogType} />
	</head>

	<body>
		<Header variant="compact" />
		<main>
			<article>
				<header class="paper-head">
					<p class="eyebrow">{eyebrow}</p>
					<h1 class="paper-title">{title}</h1>
					{subtitle && <p class="paper-subtitle"><em>{subtitle}</em></p>}
					{byline && <p class="paper-byline">{byline}</p>}
					{companion && (
						<p class="paper-companion">
							<a href={companion.href}>{companion.label}</a>
						</p>
					)}
					{paperLog?.last_edit && (
						<p class="paper-edited">
							last edited <span class="paper-edited-rel" data-iso={paperLog.last_edit}>recently</span>
							<span class="paper-edited-sep">·</span>
							<span class="paper-edited-count">{paperLog.commits_7d}</span> commits this week
						</p>
					)}
				</header>
				<div class="prose">
					<slot />
				</div>
				{share && (
					<aside class="paper-share" data-share>
						<p class="share-eyebrow">Share</p>
						<button type="button" class="share-button" data-share-trigger>
							<span class="share-label">Share this report</span>
						</button>
						<p class="share-status" data-share-status aria-live="polite"></p>
					</aside>
				)}
				<PaperLog />
			</article>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const root = document.querySelector('[data-share]');
				if (!root) return;
				const btn = root.querySelector('[data-share-trigger]');
				const status = root.querySelector('[data-share-status]');
				if (!btn) return;
				btn.addEventListener('click', async function () {
					const url = window.location.href;
					const title = document.title;
					const descMeta = document.querySelector('meta[name="description"]');
					const text = descMeta ? descMeta.getAttribute('content') || '' : '';
					if (navigator.share) {
						try {
							await navigator.share({ title: title, text: text, url: url });
						} catch (_) {
							/* user cancelled — silent */
						}
						return;
					}
					try {
						await navigator.clipboard.writeText(url);
						if (status) {
							status.textContent = 'link copied';
							setTimeout(function () { status.textContent = ''; }, 2200);
						}
					} catch (_) {
						if (status) status.textContent = url;
					}
				});
			})();
		</script>

		<script is:inline>
			(function () {
				const fmt = (iso) => {
					const then = new Date(iso).getTime();
					if (Number.isNaN(then)) return null;
					const diffMin = Math.max(0, Math.round((Date.now() - then) / 60000));
					if (diffMin < 60) return diffMin + 'm ago';
					const diffH = Math.round(diffMin / 60);
					if (diffH < 48) return diffH + 'h ago';
					return Math.round(diffH / 24) + 'd ago';
				};
				document.querySelectorAll('[data-iso]').forEach((el) => {
					const out = fmt(el.dataset.iso);
					if (out) el.textContent = out;
				});
			})();
		</script>

		<style>
			main {
				margin: 0;
				padding: 0;
			}

			article {
				max-width: 100%;
			}

			.paper-head {
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: 5rem 1.25rem 3rem;
			}

			@media (max-width: 720px) {
				.paper-head {
					padding: 2.5rem 1.25rem 2rem;
				}
				.eyebrow {
					margin-bottom: 1rem;
				}
				.paper-title {
					font-size: clamp(32px, 8vw, 40px);
				}
				.paper-subtitle {
					font-size: 17px;
				}
			}

			.eyebrow {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--muted);
				margin: 0 0 1.5rem;
			}

			.paper-title {
				font-family: var(--font-display);
				font-weight: 900;
				font-size: clamp(44px, 6vw, 72px);
				line-height: 0.95;
				letter-spacing: -0.03em;
				font-variation-settings: "opsz" 9, "SOFT" 0, "WONK" 0;
				color: var(--ink);
				margin: 0 0 1rem;
			}

			.paper-subtitle {
				font-family: var(--font-prose);
				font-style: italic;
				font-size: 20px;
				line-height: 1.45;
				color: var(--muted);
				margin: 0 0 1.25rem;
			}

			.paper-subtitle em {
				font-style: italic;
			}

			.paper-byline {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				line-height: 1.5;
				color: var(--muted);
				margin: 0;
			}

			.paper-companion {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				line-height: 1.5;
				color: var(--muted);
				margin: 1.25rem 0 0;
			}

			.paper-companion a {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.paper-edited {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 11px;
				letter-spacing: 0.04em;
				line-height: 1.5;
				color: var(--muted);
				margin: 1.25rem 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				align-items: baseline;
			}

			.paper-edited-rel,
			.paper-edited-count {
				color: var(--ink);
			}

			.paper-edited-sep {
				color: var(--rule);
			}

			.paper-share {
				max-width: var(--container-prose);
				margin: 4rem auto 0;
				padding: 2rem 1.25rem 3rem;
				border-top: 1px solid var(--rule);
			}

			.share-eyebrow {
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.18em;
				color: var(--muted);
				margin: 0 0 1rem;
			}

			.share-button {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.16em;
				color: var(--accent);
				background: transparent;
				border: 1px solid var(--accent);
				border-radius: var(--radius-md);
				padding: 0.7em 1.1em;
				cursor: pointer;
				transition: background 120ms ease-out, color 120ms ease-out;
			}

			.share-button:hover,
			.share-button:focus-visible {
				background: var(--accent-soft);
				outline: none;
			}

			.share-status {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 12px;
				color: var(--muted);
				margin: 0.75rem 0 0;
				min-height: 1em;
			}

			.prose {
				max-width: var(--container-prose);
				margin: 0 auto;
				padding: 1rem 1.25rem 4rem;
				color: var(--ink);
				font-family: var(--font-prose);
				font-size: 18px;
				line-height: 1.65;
				font-feature-settings: "onum" 1;
			}

			.prose :global(p) {
				margin: 0 0 1.1em;
			}

			/* Drop cap on the very first paragraph — Press v0.2 signature. */
			.prose :global(p:first-of-type::first-letter) {
				font-family: var(--font-display);
				font-weight: 900;
				font-variation-settings: "opsz" 9, "SOFT" 0, "WONK" 0;
				float: left;
				font-size: 5.2em;
				line-height: 0.85;
				padding: 0.08em 0.12em 0 0;
				color: var(--accent);
			}

			.prose :global(h2) {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: 32px;
				line-height: 1.15;
				letter-spacing: -0.01em;
				font-variation-settings: "opsz" 36, "SOFT" 0, "WONK" 0;
				color: var(--ink);
				margin: 2.4em 0 0.6em;
			}

			.prose :global(h3) {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 22px;
				line-height: 1.2;
				letter-spacing: -0.005em;
				font-variation-settings: "opsz" 14, "SOFT" 0, "WONK" 0;
				color: var(--ink);
				margin: 2em 0 0.5em;
			}

			.prose :global(em),
			.prose :global(i) {
				font-style: italic;
			}

			.prose :global(strong),
			.prose :global(b) {
				font-weight: 600;
			}

			.prose :global(blockquote) {
				border-left: 2px solid var(--accent);
				padding: 0 1.25em;
				margin: 1.6em 0;
				font-style: italic;
				color: var(--muted);
			}

			.prose :global(blockquote p) {
				margin: 0.5em 0;
			}

			.prose :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.prose :global(a:hover) {
				text-decoration-thickness: 2px;
			}

			.prose :global(hr) {
				border: 0;
				border-top: 1px solid var(--rule);
				margin: 3em 0;
			}

			.prose :global(code) {
				font-family: var(--font-mono);
				font-feature-settings: "tnum" 1;
				font-size: 0.9em;
				background: var(--accent-soft);
				color: var(--accent);
				padding: 0.1em 0.4em;
				border-radius: var(--radius-md);
			}

			.prose :global(pre) {
				font-family: var(--font-mono);
				font-size: 14px;
				line-height: 1.55;
				background: var(--surface);
				border: 1px solid var(--rule);
				border-radius: var(--radius-md);
				padding: 1em 1.2em;
				overflow-x: auto;
				margin: 1.5em 0;
			}

			.prose :global(pre code) {
				background: transparent;
				color: var(--ink);
				padding: 0;
				border-radius: 0;
				font-size: 14px;
			}

			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.5em;
				margin: 1em 0;
			}

			.prose :global(li) {
				margin: 0.4em 0;
			}

			/* Figures sit on the page like print — no card framing.
			   Wider than prose, narrower than the screen. Hairline above
			   and below ties them into the typography rhythm. */
			.prose :global(figure) {
				margin: 3em auto;
				margin-left: 50%;
				transform: translateX(-50%);
				width: min(var(--container-figure), calc(100vw - 2.5rem));
				padding: 1.5em 0 0;
				border-top: 1px solid var(--rule);
			}

			.prose :global(figure a) {
				display: block;
				text-decoration: none;
				border-radius: var(--radius-md);
				cursor: zoom-in;
			}

			.prose :global(figure a:focus-visible) {
				outline: 2px solid var(--accent);
				outline-offset: 4px;
			}

			.prose :global(figure img) {
				width: 100%;
				height: auto;
				display: block;
				border: 0;
				border-radius: 0;
				/* Mix-blend keeps PNG whites from sitting as a bright slab on
				   cream paper, without darkening colored data lines. */
				background: transparent;
			}

			/* Optional darker-paper dim in dark mode — keeps figures from
			   glowing against the dark background. */
			:global(html.dark) .prose :global(figure img) {
				opacity: 0.92;
				transition: opacity 150ms ease-out;
			}

			:global(html.dark) .prose :global(figure img:hover) {
				opacity: 1;
			}

			.prose :global(figcaption) {
				font-family: var(--font-prose);
				font-size: 14px;
				line-height: 1.55;
				color: var(--muted);
				margin: 1em auto 0;
				max-width: var(--container-prose);
				padding: 1em 0.5rem 0;
				border-top: 1px solid var(--rule);
				font-style: italic;
			}

			.prose :global(figcaption strong) {
				color: var(--ink);
				font-style: normal;
				font-weight: 600;
				margin-right: 0.25em;
			}

			/* Tables — block-scrollable so wide grids (8+ cols of regression
			   numbers, etc.) survive narrow viewports. Scroll shadows on the
			   left/right edges signal that the table extends beyond view. */
			.prose :global(table) {
				display: block;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				border-collapse: collapse;
				width: 100%;
				margin: 1.5em 0;
				font-size: 15px;
				background:
					linear-gradient(to right, var(--paper) 30%, transparent),
					linear-gradient(to right, transparent, var(--paper) 70%) 100% 0,
					radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.18), transparent),
					radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.18), transparent) 100% 0;
				background-repeat: no-repeat;
				background-size: 36px 100%, 36px 100%, 12px 100%, 12px 100%;
				background-attachment: local, local, scroll, scroll;
			}

			:global(html.dark) .prose :global(table) {
				background:
					linear-gradient(to right, var(--paper) 30%, transparent),
					linear-gradient(to right, transparent, var(--paper) 70%) 100% 0,
					radial-gradient(farthest-side at 0 50%, rgba(255, 255, 255, 0.12), transparent),
					radial-gradient(farthest-side at 100% 50%, rgba(255, 255, 255, 0.12), transparent) 100% 0;
				background-repeat: no-repeat;
				background-size: 36px 100%, 36px 100%, 12px 100%, 12px 100%;
				background-attachment: local, local, scroll, scroll;
			}

			.prose :global(th) {
				font-family: var(--font-mono);
				font-size: 12px;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--muted);
				text-align: left;
				padding: 0.6em 0.8em;
				border-bottom: 1px solid var(--rule);
				white-space: nowrap;
			}

			.prose :global(td) {
				padding: 0.6em 0.8em;
				border-bottom: 1px solid var(--rule);
				vertical-align: top;
			}

			/* Numeric / short-token cells stay on one line; long-prose cells
			   (the rare ones) can still wrap by overriding via inline class. */
			.prose :global(td) {
				white-space: nowrap;
			}
			.prose :global(td:last-child) {
				white-space: normal;
				min-width: 12em;
			}

			@media (max-width: 720px) {
				.prose {
					font-size: 16px;
					line-height: 1.6;
					padding: 0.5rem 1.25rem 3rem;
				}
				.prose :global(h2) {
					font-size: 24px;
					margin-top: 1.8em;
					letter-spacing: -0.005em;
				}
				.prose :global(h3) {
					font-size: 18px;
					margin-top: 1.6em;
				}
				/* Edge-to-edge figure bleed on small screens — full viewport
				   width minus a hair of breathing room. The breakout still
				   centers via the 50% / -50% trick. */
				.prose :global(figure) {
					margin: 1.75em auto;
					margin-left: 50%;
					transform: translateX(-50%);
					width: 100vw;
					max-width: 100vw;
					padding: 0.85em 0 0;
					border-top-color: var(--rule);
				}
				.prose :global(figure a),
				.prose :global(figure img) {
					border-radius: 0;
				}
				.prose :global(figcaption) {
					font-size: 13px;
					padding: 0.85em 1.25rem 0;
					margin: 0.85em auto 0;
					max-width: calc(100vw - 2rem);
				}
				/* Tables: full-bleed on mobile so the scroll axis is the
				   viewport, not a card. Slightly smaller text packs more
				   columns into the visible area. */
				.prose :global(table) {
					font-size: 13px;
					margin-left: -1.25rem;
					margin-right: -1.25rem;
					padding: 0 1.25rem;
					width: calc(100% + 2.5rem);
					max-width: none;
					background-size: 28px 100%, 28px 100%, 10px 100%, 10px 100%;
				}
				.prose :global(th),
				.prose :global(td) {
					padding: 0.5em 0.7em;
				}
				.prose :global(td:last-child) {
					min-width: 14em;
				}
				.prose :global(pre) {
					font-size: 13px;
					padding: 0.85em 1em;
					/* Allow horizontal scroll without trapping the page scroll */
					margin-left: -1.25rem;
					margin-right: -1.25rem;
					border-radius: 0;
					border-left: 0;
					border-right: 0;
				}
				.prose :global(blockquote) {
					padding: 0 1em;
					margin: 1.4em 0;
				}
			}
		</style>
	</body>
</html>
