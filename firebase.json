{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css|webp|avif|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/field",
        "destination": "/races",
        "type": 301
      },
      {
        "source": "/field/**",
        "destination": "/races",
        "type": 301
      },
      {
        "source": "/coach",
        "destination": "/races",
        "type": 301
      },
      {
        "source": "/coach/**",
        "destination": "/races",
        "type": 301
      },
      {
        "source": "/paper",
        "destination": "/builds",
        "type": 301
      },
      {
        "source": "/paper/**",
        "destination": "/builds",
        "type": 301
      }
    ]
  }
}
